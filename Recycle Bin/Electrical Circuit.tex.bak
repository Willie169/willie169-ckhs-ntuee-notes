\sssc{Second-order canonical low-pass circuit}
A second-order canonical low-pass filter has the form
\[s^2F(s)+2\zeta\omega_0 sF(s)+\omega_0^{\pht{0}2}F(s)=\omega_0^{\pht{0}2}X(s)\]
\[F(s)=\frac{\omega_0^{\pht{0}2}X(s)}{s^2+2\zeta\omega_0 s+\omega_0^{\pht{0}2}}\]
\[H(s)=\frac{F(s)}{X(s)}=\frac{\omega_0^{\pht{0}2}}{s^2+2\zeta\omega_0 s+\omega_0^{\pht{0}2}}.\]
The poles on the complex plane are
\[r_{1,2}=-\alpha\pm j\omega_d.\]
The frequency response is
\[H(j\omega)=\frac{\omega_0^{\pht{0}2}}{\omega_0^{\pht{0}2}-\omega^2+j2\zeta\omega_0\omega}.\]
Magnitude response is
\[\abs{H(j\omega)}^2=\frac{\omega_0^{\pht{0}4}}{(\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2}.\]
Filter:
\[\lim_{\omega\to0}\abs{H(j\omega)}=1\]
\[\lim_{\omega\to\infty}\abs{H(j\omega)}=0.\]
When $\zeta<\frac{1}{\sqrt{2}}$, the resonance frequency $\omega_r$ is
\[\omega_r=\arg_{\omega}\max_{\omega}\abs{H(j\omega)}=\omega_0\sqrt{1-2\zeta^2},\]
and
\[\max_{\omega}\abs{H(j\omega)}=\abs{H(j\omega_r)}=\frac{1}{2\zeta\sqrt{1-\zeta^2}}.\]
\bpr
\[\dv{\abs{H(j\omega)}^2}{\omega}=-\frac{\omega_0^{\pht{0}4}}{\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)^2}\dv{}{\omega}((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)\]
\[\ba
\dv{}{\omega}((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)=&\dv{}{\omega}(\omega_0^{\pht{0}4}-2\omega_0^{\pht{0}2}\omega^2+\omega^4+4\zeta^2\omega_0^{\pht{0}2}\omega^2)\\
=&-4\omega_0^{\pht{0}2}\omega+4\omega^3+8\zeta^2\omega_0^{\pht{0}2}\omega\\
=&4\omega\qty(\omega^2-\qty(1-2\zeta^2)\omega_0^{\pht{0}2})
\ea\]
\[\omega=0\lor\omega_0\sqrt{1-2\zeta^2}\]
\[\abs{H(j0)}^2=1\]
\[\ba
\abs{H(j\omega_0\sqrt{1-2\zeta^2})}^2=&\frac{1}{(2\zeta^2)^2+(2\zeta\sqrt{1-2\zeta^2})^2}\\
=&\frac{1}{4\zeta^2-4\zeta^4}
\ea\]
\epr
The cutoff frequency $\omega_{1,2}$ such that
\[\abs{H(j\omega_{1,2})}=\frac{1}{\sqrt{2}}\]
are
\[\omega_{1,2}=
\omega_0,\]
where $\omega_2$ is called upper half-power frequency and $\omega_1$ is called lower half-power frequency.
\bpr
Let $\omega_{1,2}=a\omega_0$.
\[\abs{H(j\omega_{1,2})}^2=\frac{1}{(1-a^2)^2+(2\zeta a)^2}=\frac{1}{1-2a^2+a^4+4\zeta^2a^2}\]
\[1-2a^2+a^4+4\zeta^2a^2=2\]
\[a^4-2a^2(1-2\zeta^2)-1=0\]
\[a^2=1-2\zeta^2\pm\sqrt{(1-2\zeta^2)^2+1}=
1-2\zeta^2\pm\sqrt{2-4\zeta^2+4\zeta^4}=??\]
??
TODO
\epr
For high-Q circuit,
\[H(j\omega)=\frac{\omega_0^{\pht{0}2}}{\omega_0^{\pht{0}2}-\omega^2+j\frac{\omega_0}{Q}\omega},\]
since $\sqrt{1\mp2x}\approx1\mp x$,
\[\omega_{1,2}\approx(1\mp\zeta)\omega_0=\omega_0\mp\alpha\approx\omega_0\qty(1\mp\frac{1}{2Q}),\]
\[\calB=\omega_2-\omega_1\approx2\zeta\omega_0=2\alpha\approx\frac{\omega_0}{Q}\]
\sssc{Second-order canonical band-pass circuit}
A second-order canonical band-pass filter has the form
\[s^2F(s)+2\zeta\omega_0 sF(s)+\omega_0^{\pht{0}2}F(s)=2\zeta\omega_0sX(s)\]
\[F(s)=\frac{2\zeta\omega_0 sX(s)}{s^2+2\zeta\omega_0 s+\omega_0^{\pht{0}2}}\]
\[H(s)=\frac{F(s)}{X(s)}=\frac{2\zeta\omega_0 s}{s^2+2\zeta\omega_0s+\omega_0^{\pht{0}2}}.\]
The poles on the complex plane are
\[r_{1,2}=-\alpha\pm j\omega_d.\]
The frequency response is
\[H(j\omega)=\frac{j2\zeta\omega_0\omega}{\omega_0^{\pht{0}2}-\omega^2+j2\zeta\omega_0\omega}.\]
Magnitude response is
\[\abs{H(j\omega)}^2=\frac{(2\zeta\omega_0\omega)^2}{(\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2}.\]
Band-pass filter whose resonance frequency is natural frequency $\omega_0$ and has magnitude gain 1:
\[\arg_{\omega}\max_{\omega}\abs{H(j\omega)}=\omega_0\]
\[\max_{\omega}\abs{H(j\omega)}=\abs{H(j\omega_0)}=1.\]
\bpr
\[\frac{1}{(2\zeta\omega_0)^2}\dv{\abs{H(j\omega)}^2}{\omega}=\frac{2\omega\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)-\omega^2\dv{}{\omega}\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)}{\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)^2}\]
\[\dv{}{\omega}\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)=4\omega^3-4\omega_0^{\pht{0}2}\omega+8\zeta^2\omega_0^{\pht{0}2}\omega\]
\[\omega_0^{\pht{0}4}-2\omega_0^{\pht{0}2}\omega^2+\omega^4+4\zeta^2\omega_0^{\pht{0}2}\omega^2-2\omega^4+2\omega_0^{\pht{0}2}\omega^2-4\zeta^2\omega_0^{\pht{0}2}\omega^2=0\]
\[\omega_0^{\pht{0}4}-\omega^4=0\]
\[\omega=\omega_0\]
\epr
The cutoff frequency $\omega_{1,2}$ such that
\[\abs{H(j\omega_{1,2})}=\frac{1}{\sqrt{2}}\]
are
\[\omega_{1,2}=\sqrt{1+2\zeta^2\mp2\zeta\sqrt{1+\zeta^2}}\omega_0,\]
where $\omega_2$ is called upper half-power frequency and $\omega_1$ is called lower half-power frequency.
\bpr
Let $\omega_{1,2}=a\omega_0$.
\[\abs{H(j\omega_{1,2})}^2=\frac{(2\zeta a)^2}{(1-a^2)^2+(2\zeta a)^2}=\frac{1}{2}\]
\[1-2a^2+a^4+4\zeta^2a^2=8\zeta^2a^2\]
\[a^4-2(1+2\zeta^2)a^2+1=0\]
\[a^2=1+2\zeta^2\pm\sqrt{(1+2\zeta^2)^2-1}=1+2\zeta^2\pm2\zeta\sqrt{1+\zeta^2}\]
\epr
For high-Q circuit,
\[H(j\omega)=\frac{j\frac{\omega_0}{Q}\omega}{\omega_0^{\pht{0}2}-\omega^2+j\frac{\omega_0}{Q}\omega},\]
since $\sqrt{1\mp2x}\approx1\mp x$,
\[\omega_{1,2}\approx(1\mp\zeta)\omega_0=\omega_0\mp\alpha\approx\omega_0\qty(1\mp\frac{1}{2Q}),\]
\[\calB=\omega_2-\omega_1\approx2\zeta\omega_0=2\alpha\approx\frac{\omega_0}{Q}\]
\sssc{Second-order canonical high-pass circuit}
A second-order canonical high-pass filter has the form
\[s^2F(s)+2\zeta\omega_0 sF(s)+\omega_0^{\pht{0}2}F(s)=s^2X(s)\]
\[F(s)=\frac{s^2X(s)}{s^2+2\zeta\omega_0 s+\omega_0^{\pht{0}2}}\]
\[H(s)=\frac{F(s)}{X(s)}=\frac{s^2}{s^2+2\zeta\omega_0s+\omega_0^{\pht{0}2}}.\]
The poles on the complex plane are
\[r_{1,2}=-\alpha\pm j\omega_d.\]
The frequency response is
\[H(j\omega)=\frac{-\omega^2}{\omega_0^{\pht{0}2}-\omega^2+j2\zeta\omega_0\omega}.\]
Magnitude response is
\[\abs{H(j\omega)}^2=\frac{\omega^4}{(\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2}.\]
High-pass filter with high-pass gain TODO:
\[\lim_{\omega\to0}\abs{H(j\omega)}=0\]
\[\lim_{\omega\to\infty}\abs{H(j\omega)}=TODO.\]
The resonance frequency is the natural frequency $\omega_0$:
\[\arg_{\omega}\max_{\omega}\abs{H(j\omega)}=\omega_0\]
\[\max_{\omega}\abs{H(j\omega)}=\abs{H(j\omega_0)}=\frac{1}{2\zeta}.\]
\bpr
\[\frac{1}{}\dv{\abs{H(j\omega)}^2}{\omega}=\frac{4\omega^3\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)-\omega^4\dv{}{\omega}\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)}{\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)^2}\]
\[\dv{}{\omega}\qty((\omega_0^{\pht{0}2}-\omega^2)^2+(2\zeta\omega_0\omega)^2)=4\omega^3-4\omega_0^{\pht{0}2}\omega+8\zeta^2\omega_0^{\pht{0}2}\omega\]
\[4\omega_0^{\pht{0}4}-8\omega_0^{\pht{0}2}\omega^2+4\omega^4+8\zeta^2\omega_0^{\pht{0}2}\omega^2-4\omega^4+4\omega_0^{\pht{0}2}\omega^2-8\zeta^2\omega_0^{\pht{0}2}\omega^2=0\]
\[\omega=\omega_0\]
\epr
The cutoff frequency $\omega_{1,2}$ such that
\[\abs{H(j\omega_{1,2})}=\frac{1}{2\sqrt{2}\zeta}\]
are
\[\omega_{1,2}=\sqrt{1+2\zeta^2\mp2\zeta\sqrt{1+\zeta^2}}\omega_0,\]
where $\omega_2$ is called upper half-power frequency and $\omega_1$ is called lower half-power frequency.
\bpr
Let $\omega_{1,2}=a\omega_0$.
\[\abs{H(j\omega_{1,2})}^2=\frac{a^4}{(1-a^2)^2+(2\zeta a)^2}=\frac{1}{8\zeta^2}\]
\[1-2a^2+a^4+4\zeta^2a^2=8\zeta^2a^4\]
\[a^4-2a^2(1+2\zeta^2)+1=0\]
\[a^2=1+2\zeta^2\pm\sqrt{(1+2\zeta^2)^2-1}=1+2\zeta^2\pm2\zeta\sqrt{1+\zeta^2}\]
\epr
For high-Q circuit,
\[H(j\omega)=\frac{-\omega^2}{\omega_0^{\pht{0}2}-\omega^2+j\frac{\omega_0}{Q}\omega},\]
since $\sqrt{1\mp2x}\approx1\mp x$,
\[\omega_{1,2}\approx(1\mp\zeta)\omega_0=\omega_0\mp\alpha\approx\omega_0\qty(1\mp\frac{1}{2Q}),\]
\[\calB=\omega_2-\omega_1\approx2\zeta\omega_0=2\alpha\approx\frac{\omega_0}{Q}\]
\ssc{R, L, C, RL, RC, LC, and RLC Circuits}
\sssc{Resistor with voltage source}
A resistor with resistance $R$ and an independent voltage source $v_{in}$ in series connection.

Natural response (time domain):
\[i=0\]
Natural response (Laplace domain):
\[I=0\]
Forced/total response (time domain):
\[i=\frac{v_{in}}{R}\]
Forced/total response (Laplace domain):
\[I=\frac{V_{in}}{R}\]
Impulse response:
\[h_i=\frac{\delta(t)}{R}\]
Transfer function:
\[H_I=\frac{1}{R}\]
\sssc{Resistor with current source}
A resistor with resistance $R$ and an independent current source $i_{in}$ in series connection.

Natural response (time domain):
\[v=0\]
Natural response (Laplace domain):
\[V=0\]
Forced/total response (time domain):
\[v=i_{in}R\]
Forced/total response (Laplace domain):
\[V=I_{in}R\]
Impulse response:
\[h_v=\delta(t)R\]
Transfer function:
\[H_V=R\]
\sssc{Inductor with voltage source}
An inductor with inductance $L$ and an independent voltage source $v_{in}$ in series connection.

Natural response (time domain):
\[i=i(0^-)\]
Natural response (Laplace domain):
\[I=i(0^-)\]
Forced response (time domain):
\[i=\int_0^t\frac{v_{in}(\tau)}{L}\dd{\tau}\]
Forced response (Laplace domain):
\[I=\frac{V_{in}}{Ls}\]
Total response (time domain):
\[i=i(0^-)+\frac{1}{L}\int_0^tv_{in}(\tau)\dd{\tau}\]
Total response (Laplace domain):
\[I=\frac{Li(0^-)+V_{in}}{Ls}\]
Constant source forced response (time domain):
\[i=\frac{v_{in}t}{L}\]
Constant source total response (time domain):
\[i=i(0^-)+\frac{v_{in}t}{L}\]
Steady-state sinusoidal AC (time domain): Source angular frequency $\omega$, maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[v_{in}=v_m\cos(\omega t+\theta)\]
\[i=\frac{v_m}{L\omega}\sin(\omega t+\theta)\]
\[E_m=\frac{v_m^{\pht{m}2}}{2L\omega^2}\]
\[E_l=0\]
\[Q=\infty\]
Steady-state sinusoidal AC (phasor domain):
\[\mb{V}_{in}=v_me^{j\theta}\]
\[\mb{I}=\frac{v_m}{L\omega}e^{j\qty(\theta-\frac{\pi}{2})}\]
Impulse response:
\[h_i=\frac{u(t)}{L}\]
Transfer function:
\[H_I=\frac{1}{Ls}\]
\sssc{Inductor with current source}
An inductor with inductance $L$ and an independent current source $i_{in}$ in series connection.

Natural response (time domain):
\[v=0\]
Natural response (Laplace domain):
\[V=0\]
Forced/total response (time domain):
\[v=L\dv{i_{in}}{t}\]
Forced/total response (Laplace domain):
\[V=I_{in}Ls\]
Constant source forced/total response/steady state (time domain):
\[v=0\]
Steady-state sinusoidal AC (time domain): Source angular frequency $\omega$, maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[i_{in}=i_m\cos(\omega t+\theta)\]
\[v=-i_mL\omega\sin(\omega t+\theta)\]
\[E_m=\frac{Li_m^{\pht{m}2}}{2}\]
\[E_l=0\]
\[Q=\infty\]
Steady-state sinusoidal AC (phasor domain):
\[\mb{I}_{in}=i_me^{j\theta}\]
\[\mb{V}=i_mL\omega e^{j\qty(\theta+\frac{\pi}{2})}\]
Impulse response:
\[h_v=\delta'(t)L\]
Transfer function:
\[H_I=Ls\]
\sssc{Capacitor with voltage source}
A capacitor with capacitance $C$ and an independent voltage source $v_{in}$ in series connection.

Natural response (time domain):
\[i=0\]
Natural response (Laplace domain):
\[I=0\]
Forced/total response (time domain):
\[i=C\dv{v_{in}}{t}\]
Forced/total response (Laplace domain):
\[I=V_{in}Cs\]
Constant source forced/total response/steady state (time domain):
\[i=0\]
Steady-state sinusoidal AC (time domain): Source angular frequency $\omega$, maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[v_{in}=v_m\cos(\omega t+\theta)\]
\[i=v_mC\omega\sin(\omega t+\theta)\]
\[E_m=\frac{Cv_m^{\pht{m}2}}{2}\]
\[E_l=0\]
\[Q=\infty\]
Steady-state sinusoidal AC (phasor domain):
\[\mb{V}_{in}=v_me^{j\theta}\]
\[\mb{I}=v_mC\omega e^{j\qty(\theta+\frac{\pi}{2})}\]
Impulse response:
\[h_i=\delta'(t)C\]
Transfer function:
\[H_I=Cs\]
\sssc{Capacitor with current source}
A capacitor with capacitance $C$ and an independent current source $i_{in}$ in series connection.

Natural response (time domain):
\[v=v(0^-)\]
Natural response (Laplace domain):
\[V=v(0^-)\]
Forced response (time domain):
\[v=\frac{1}{C}\int_0^ti_{in}(\tau)\dd{\tau}\]
Forced response (Laplace domain):
\[V=\frac{I_{in}}{Cs}\]
Total response (time domain):
\[v=v(0^-)+\frac{1}{C}\int_0^ti_{in}(\tau)\dd{\tau}\]
Total response (Laplace domain):
\[V=\frac{Cv(0^-)+I_{in}}{Cs}\]
Constant source forced response (time domain):
\[v=\frac{i_{in}t}{C}\]
Constant source total response (time domain):
\[v=v(0^-)+\frac{i_{in}t}{C}\]
Steady-state sinusoidal AC (time domain): Source angular frequency $\omega$, maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[i_{in}=i_m\cos(\omega t+\theta)\]
\[v=\frac{i_m}{C\omega}\sin(\omega t+\theta)\]
\[E_m=\frac{i_m^{\pht{m}2}}{2C\omega^2}\]
\[E_l=0\]
\[Q=\infty\]
Steady-state sinusoidal AC (phasor domain):
\[\mb{I}_{in}=i_me^{j\theta}\]
\[\mb{V}=\frac{i_m}{C\omega}e^{j\qty(\theta-\frac{\pi}{2})}\]
Impulse response:
\[h_v=\frac{u(t)}{C}\]
Transfer function:
\[H_V=\frac{1}{Cs}\]
\sssc{RL circuit}
A (series) RL circuit or filter consists of a resistor with resistance $R$, an inductor with inductance $L$, and an independent voltage source $v_{in}$ in series connection.

Natural response (time domain):
\[Ri+L\dv{i}{t}=0\]
\[i=i(0^-)e^{-\frac{R}{L}t}\]
\[v_R=-v_L=Ri(0^-)e^{-\frac{R}{L}t}\]
\[\tau_i=\tau_{v_R}=\tau_{v_L}=\frac{L}{R}\]
\[p_R=-p_L=R(i(0^-))^2e^{-2\frac{R}{L}t}\]
\[\int_0^{\infty}p_R\dd{t}=-\int_0^{\infty}p_L\dd{t}=\frac{1}{2}L(i(0^-))^2\]
\begin{proof}
\[Ri+L\dv{i}{t}=0\]
\[Lr+R=0\]
\[r=-\frac{R}{L}\]
\[i=Ae^{-\frac{R}{L}t}\]
\[i=i(0^-)e^{-\frac{R}{L}t}\]
\[v_R=-v_L=Ri(0^-)e^{-\frac{R}{L}t}\]
\[p_R=-p_L=R(i(0^-))^2e^{-2\frac{R}{L}t}\]
\[\ba
\int_0^{\infty}p_R\dd{t}&=R(i(0^-))^2\evlv(-\frac{L}{2R}e^{-2\frac{R}{L}t})_0^{\infty}\\
&=\frac{1}{2}L(i(0^-))^2
\ea\]
\end{proof}
Natural response (Laplace domain):
\[I=\frac{Li(0^-)}{R+Ls}\]
\[V_R=-V_L=\frac{RLi(0^-)}{R+Ls}\]
\begin{proof}
Check consistency:
\[\mathcal{L}\{i\}=\frac{i(0^-)}{s+\frac{R}{L}}=\frac{Li(0^-)}{R+Ls}\]
\[\mathcal{L}\{v_R\}=Ri(0^-)\frac{1}{s+\frac{R}{L}}=\frac{RLi(0^-)}{R+Ls}\]
\end{proof}
Forced response (time domain):
\[Ri+L\dv{i}{t}=v_{in}\]
\[i=\frac{1}{L}\int_0^te^{\frac{R}{L}\tau}v_{in}(\tau)\dd{\tau}e^{-\frac{R}{L}t}\]
\[v_R=v_{in}-v_L=\frac{R}{L}\int_0^te^{\frac{R}{L}\tau}v_{in}(\tau)\dd{\tau}e^{-\frac{R}{L}t}\]
\begin{proof}
\[Ri+L\dv{i}{t}=v_{in}\]
\[\dv{i}{t}+\frac{R}{L}i=\frac{v_{in}}{L}\]
\[\mu(t)=e^{\int\frac{R}{L}\dd{t}}=e^{\frac{R}{L}t}\]
\[\dv{}{t}\qty(e^{\frac{R}{L}t}i)=e^{\frac{R}{L}t}\frac{v_{in}}{L}\]
\[i=\frac{1}{L}\int_0^te^{\frac{R}{L}\tau}v_{in}(\tau)\dd{\tau}e^{-\frac{R}{L}t}\]
\end{proof}
Forced response (Laplace domain):
\[I=\frac{V_{in}}{R+Ls}\]
\[V_R=\frac{RV_{in}}{R+Ls}\]
\[V_L=\frac{LsV_{in}}{R+Ls}\]
\begin{proof}
Check consistency:
\[\ba
\mathcal{L}\{i\}&=\frac{1}{L}\mathcal{L}\{\int_0^te^{\frac{R}{L}\tau}v_{in}(\tau)u(t-\tau)\dd{\tau}\}\qty(s+\frac{R}{L})\\
&=\frac{1}{L}\mathcal{L}\{e^{\frac{R}{L}t}v_{in}(t)\}\qty(s+\frac{R}{L})\mathcal{L}\{u(t)\}\qty(s+\frac{R}{L})\\
&=\frac{1}{L}V_{in}\qty(s-\frac{R}{L}+\frac{R}{L})\frac{1}{s+\frac{R}{L}}\\
&=\frac{V_{in}}{R+Ls}
\ea\]
\end{proof}
Total response (time domain):
\[i=\qty(i(0^-)+\frac{1}{L}\int_0^te^{\frac{R}{L}\tau}v_{in}(\tau)\dd{\tau})e^{-\frac{R}{L}t}\]
\[v_R=v_{in}-v_L=R\qty(i(0^-)+\frac{1}{L}\int_0^te^{\frac{R}{L}\tau}v_{in}(\tau)\dd{\tau})e^{-\frac{R}{L}t}\]
Total response (Laplace domain):
\[I=\frac{Li(0^-)+V_{in}}{R+Ls}\]
\[V_R=\frac{RLi(0^-)+RV_{in}}{R+Ls}\]
\[V_L=\frac{LsV_{in}-RLi(0^-)}{R+Ls}\]
Steady state (time domain):
\[i=\frac{v_{in}}{R}\]
\[v_R=v_{in}\]
\[v_L=0\]
Constant source forced response (time domain):
\[i=\frac{v_{in}}{R}\qty(1-e^{-\frac{R}{L}t})=i(\infty)-i(\infty)e^{-\frac{R}{L}t}\]
\[v_L=v_{in}-v_R=v_{in}e^{-\frac{R}{L}t}=i(\infty)Re^{-\frac{R}{L}t}\]
Constant source total response (time domain):
\[i=\frac{v_{in}}{R}-\qty(\frac{v_{in}}{R}-i(0^-))e^{-\frac{R}{L}t}=i(\infty)+\qty(i(0^-)-i(\infty))e^{-\frac{R}{L}t}\]
\[v_L=v_{in}-v_R=\qty(v_{in}-i(0^-)R)e^{-\frac{R}{L}t}=-\qty(i(0^-)-i(\infty))Re^{-\frac{R}{L}t}\]
Steady-state sinusoidal AC (time domain): Source angular frequency $\omega$, maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[v_{in}=v_m\cos(\omega t+\theta)\]
\[i=\frac{v_m}{\sqrt{R^2+L^2\omega^2}}\cos(\omega t+\theta-\arctan(\frac{L\omega}{R}))\]
\[v_R=\frac{v_mR}{\sqrt{R^2+L^2\omega^2}}\cos(\omega t+\theta-\arctan(\frac{L\omega}{R}))\]
\[v_L=-\frac{v_mL\omega}{\sqrt{R^2+L^2\omega^2}}\sin(\omega t+\theta-\arctan(\frac{L\omega}{R}))\]
\[E_m=\frac{Lv_m^{\pht{m}2}}{2\qty(R^2+L^2\omega^2)}\]
\[E_l=\frac{Rv_m^{\pht{m}2}\pi}{\omega\qty(R^2+L^2\omega^2)}\]
\[Q=\frac{L\omega}{R}\]
Steady-state sinusoidal AC (phasor domain):
\[\mb{V}_{in}=v_me^{j\theta}\]
\[\mb{I}=\frac{v_m}{\sqrt{R^2+L^2\omega^2}}e^{j\qty(\theta-\arctan(\frac{L\omega}{R}))}\]
\[\mb{V}_R=\frac{v_mR}{\sqrt{R^2+L^2\omega^2}}e^{j\qty(\theta-\arctan(\frac{L\omega}{R}))}\]
\[\mb{V}_L=\frac{v_mL\omega}{\sqrt{R^2+L^2\omega^2}}e^{j\qty(\theta-\arctan(\frac{L\omega}{R})+\frac{\pi}{2})}\]
Impulse response:
\[h_i=\frac{1}{L}u(t)e^{-\frac{R}{L}t}\]
\[h_{v_R}=\frac{R}{L}u(t)e^{-\frac{R}{L}t}\]
\[h_{v_L}=\delta(t)-\frac{R}{L}u(t)e^{-\frac{R}{L}t}\]
\begin{proof}
\[h_i=\frac{1}{L}\int_0^te^{\frac{R}{L}\tau}\delta(\tau)\dd{\tau}e^{-\frac{R}{L}t}=\frac{1}{L}u(t)e^{-\frac{R}{L}t}\]
\end{proof}
Transfer function:
\[H_I=\frac{1}{R+Ls}\]
\[H_{V_R}=\frac{R}{R+Ls}\]
\[H_{V_L}=\frac{Ls}{R+Ls}\]
\begin{proof}
Check consistency:
\[\mathcal{L}\{h_i\}=\frac{1}{L\qty(s+\frac{R}{L})}=\frac{1}{R+Ls}\]
\[\mathcal{L}\{h_{V_L}\}=1-\frac{R}{R+Ls}=\frac{Ls}{R+Ls}\]
\end{proof}
$V_R$ being low-pass filter:
\[\lim_{\omega\to 0}\abs{H_{V_R}(j\omega)}=1\]
\[\lim_{\omega\to\infty}\abs{H_{V_R}(j\omega)}=0\]
\begin{proof}
\[\lim_{\omega\to 0}\abs{H_{V_R}(j\omega)}=\lim_{\omega\to 0}\abs{\frac{R}{R+Lj\omega}}=1\]
\[\lim_{\omega\to\infty}\abs{H_{V_R}(j\omega)}=\lim_{\omega\to\infty}\abs{\frac{R}{R+Lj\omega}}=0\]
\end{proof}
$V_L$ being high-pass filter:
\[\lim_{\omega\to 0}\abs{H_{V_L}(j\omega)}=0\]
\[\lim_{\omega\to\infty}\abs{H_{V_L}(j\omega)}=1\]
\begin{proof}
\[\lim_{\omega\to 0}\abs{H_{V_L}(j\omega)}=\lim_{\omega\to 0}\abs{\frac{Lj\omega}{R+Lj\omega}}=0\]
\[\lim_{\omega\to\infty}\abs{H_{V_L}(j\omega)}=\lim_{\omega\to\infty}\abs{\frac{Lj\omega}{R+Lj\omega}}=1\]
\end{proof}
\sssc{RC circuit}
A (series) RC circuit or filter consists of a resistor with resistance $R$, a capacitor with capacitance $C$, and an independent voltage source $v_{in}$ in series connection.

Natural response (time domain):
\[\frac{v_C}{R}+C\dv{v_C}{t}=0\]
\[v_C=-v_R=v_C(0^-)e^{-\frac{1}{RC}t}\]
\[i=-\frac{1}{R}v_C(0^-)e^{-\frac{1}{RC}t}\]
\[\tau_{v_C}=\tau_{v_R}=\tau_i=\frac{1}{RC}\]
\[p_R=-p_C=\frac{1}{R}(v_C(0^-))^2e^{-\frac{2}{RC}t}\]
\[\int_0^{\infty}p_R\dd{t}=-\int_0^{\infty}p_C\dd{t}=\frac{1}{2}C(v_C(0^-))^2\]
\begin{proof}
\[v_R+v_C=0\]
\[\frac{v_R}{R}-C\dv{v_C}{t}=0\]
\[\frac{v_C}{R}+C\dv{v_C}{t}=0\]
\[Cr+\frac{1}{R}=0\]
\[r=-\frac{1}{RC}\]
\[v_C=Ae^{-\frac{1}{RC}t}\]
\[v_C=v_C(0^-)e^{-\frac{1}{RC}t}\]
\[i=-\frac{1}{R}v_C(0^-)e^{-\frac{1}{RC}t}\]
\[p_R=-p_C=\frac{1}{R}(v_C(0^-))^2e^{-\frac{2}{RC}t}\]
\[\ba
\int_0^{\infty}p_R\dd{t}&=\frac{1}{R}(v_C(0^-))^2\evlv{-\frac{RC}{2}e^{-\frac{2}{RC}t}}_0^{\infty}\\
&=\frac{1}{2}C(v_C(0^-))^2
\ea\]
\end{proof}
Natural response (Laplace domain):
\[V_C=-V_R=\frac{RCv_C(0^-)}{1+RCs}\]
\[I=-\frac{Cv_C(0^-)}{1+RCs}\]
\begin{proof}
\[I=-\frac{v_C(0^-)}{s\qty(\frac{1}{Cs}+R)}=-\frac{Cv_C(0^-)}{1+RCs}\]
\[V_C=\frac{I+Cv_C(0^-)}{Cs}=\frac{RCv_C(0^-)}{1+RCs}\]
Check consistency:
\[\mathcal{L}\{v_C\}=\frac{v_C(0^-)}{s+\frac{1}{RC}}=\frac{RCv_C(0^-)}{1+RCs}\]
\[\mathcal{L}\{i\}=-\frac{1}{R}v_C(0^-)\frac{1}{s+\frac{1}{RC}}=-\frac{Cv_C(0^-)}{1+RCs}\]
\end{proof}
Forced response (time domain):
\[\frac{v_C-v_{in}}{R}+C\dv{v_C}{t}=0\]
\[v_C=v_{in}-v_R=\frac{1}{RC}\int_0^te^{\frac{1}{RC}\tau}v_{in}(\tau)\dd{\tau}e^{-\frac{1}{RC}t}\]
\[i=\frac{1}{R}\qty(v_{in}-\frac{1}{RC}\int_0^te^{\frac{1}{RC}\tau}v_{in}(\tau)\dd{\tau}e^{-\frac{1}{RC}t})\]
\begin{proof}
\[v_R+v_C=v_{in}\]
\[\frac{v_R}{R}-C\dv{v_C}{t}=0\]
\[\frac{v_C-v_{in}}{R}+C\dv{v_C}{t}=0\]
\[\dv{v_C}{t}+\frac{v_C}{RC}=\frac{v_{in}}{RC}\]
\[\mu(t)=e^{\int\frac{1}{RC}\dd{t}}=e^{\frac{1}{RC}t}\]
\[\dv{}{t}\qty(e^{\frac{1}{RC}t}v_C)=e^{\frac{1}{RC}t}\frac{v_{in}}{RC}\]
\[v_C=\frac{1}{RC}\int_0^te^{\frac{1}{RC}\tau}v_{in}(\tau)\dd{\tau}e^{-\frac{1}{RC}t}\]
\end{proof}
Forced response (Laplace domain):
\[V_C=\frac{V_{in}}{1+RCs}\]
\[V_R=\frac{RCsV_{in}}{1+RCs}\]
\[I=-\frac{CsV_{in}}{1+RCs}\]
\begin{proof}
\[V_C=\frac{1}{\frac{1}{R}+Cs}CV_{in}=\frac{RCV_{in}}{1+RCs}\]
Check consistency:
\[\ba
\mathcal{L}\{v_C\}&=\frac{1}{RC}\mathcal{L}\{\int_0^te^{\frac{1}{RC}\tau}v_{in}(\tau)u(t-\tau)\dd{\tau}\}\qty(s+\frac{1}{RC})\\
&=\frac{1}{RC}\mathcal{L}\{e^{\frac{1}{RC}t}v_{in}(t)\}\qty(s+\frac{1}{RC})\mathcal{L}\{u(t)\}\qty(s+\frac{1}{RC})\\
&=\frac{1}{RC}V_{in}\qty(s-\frac{1}{RC}+\frac{1}{RC})\frac{1}{s+\frac{1}{RC}}\\
&=\frac{V_{in}}{1+RCs}
\ea\]
\end{proof}
Total response (time domain):
\[v_C=v_{in}-v_R=\qty(v_C(0^-)+\frac{1}{RC}\int_0^te^{\frac{1}{RC}\tau}v_{in}(\tau)\dd{\tau})e^{-\frac{1}{RC}t}\]
\[i=\frac{1}{R}\qty(v_{in}-\qty(v_C(0^-)+\frac{1}{RC}\int_0^te^{\frac{1}{RC}\tau}v_{in}(\tau)\dd{\tau})e^{-\frac{1}{RC}t})\]
Total response (Laplace domain):
\[V_C=\frac{RCv_C(0^-)+V_{in}}{1+RCs}\]
\[V_R=\frac{-RCv_C(0^-)+RCsV_{in}}{1+RCs}\]
\[I=-\frac{Cv_C(0^-)+CsV_{in}}{1+RCs}\]
Steady state (time domain):
\[v_C=v_{in}\]
\[v_R=0\]
\[i=0\]
Constant source forced response (time domain):
\[v_C=v_{in}-v_R=v_{in}\qty(1-e^{-\frac{1}{RC}t})=v_C(\infty)-v_C(\infty)e^{-\frac{1}{RC}t}\]
\[i=\frac{v_{in}}{R}e^{-\frac{1}{RC}t}=\frac{v_C(\infty)}{R}e^{-\frac{1}{RC}t}\]
Constant source total response (time domain):
\[v_C=v_{in}-v_R=v_{in}-\qty(v_{in}-v_C(0^-))e^{-\frac{1}{RC}t}=v_C(\infty)+(v_C(0^-)-v_C(\infty))e^{-\frac{1}{RC}t}\]
\[i=\frac{v_{in}-v_C(0^-)}{R}e^{-\frac{1}{RC}t}=-\frac{v_C(0^-)-v_C(\infty)}{R}e^{-\frac{1}{RC}t}\]

Steady-state sinusoidal AC (time domain): Source angular frequency $\omega$, maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[v_{in}=v_m\cos(\omega t+\theta)\]
\[i=\frac{v_mC\omega}{\sqrt{R^2C^2\omega^2+1}}\cos(\omega t+\theta+\arctan(\frac{1}{RC\omega}))\]
\[v_C=\frac{v_m}{\sqrt{R^2C^2\omega^2+1}}\sin(\omega t+\theta+\arctan(\frac{1}{RC\omega}))\]
\[v_R=\frac{v_mRC\omega}{\sqrt{R^2C^2\omega^2+1}}\cos(\theta+\arctan(\frac{1}{RC\omega}))\]
\[E_m=\frac{Cv_m^{\pht{m}2}}{2\qty(R^2C^2\omega^2+1)}\]
\[E_l=\frac{RC^2\omega^2v_m^{\pht{m}2}\pi}{\omega\qty(R^2C^2\omega^2+1)}\]
\[Q=\frac{1}{RC\omega}\]
Steady-state sinusoidal AC (phasor domain):
\[\mb{V}_{in}=v_me^{j\theta}\]
\[\mb{I}=\frac{v_mC\omega}{\sqrt{R^2C^2\omega^2+1}}e^{j\qty(\theta+\arctan(\frac{1}{RC\omega}))}\]
\[\mb{V}_C=\frac{v_m}{\sqrt{R^2C^2\omega^2+1}}e^{j\qty(\theta+\arctan(\frac{1}{RC\omega})-\frac{\pi}{2})}\]
\[\mb{V}_R=\frac{v_mRC\omega}{\sqrt{R^2C^2\omega^2+1}}e^{j\qty(\theta+\arctan(\frac{1}{RC\omega}))}\]
Impulse response:
\[h_{v_C}=\frac{1}{RC}u(t)e^{-\frac{1}{RC}t}\]
\[h_{v_R}=\delta(t)-\frac{1}{RC}u(t)e^{-\frac{1}{RC}t}\]
\[h_i=\frac{1}{R}\qty(\delta(t)-\frac{1}{RC}u(t)e^{-\frac{1}{RC}t})\]
\begin{proof}
\[h_{v_C}=\frac{1}{RC}\int_0^te^{\frac{1}{RC}\tau}\delta(\tau)\dd{\tau}e^{-\frac{1}{RC}t}=\frac{1}{RC}u(t)e^{-\frac{1}{RC}t}\]
\end{proof}
Transfer function:
\[H_{V_C}=\frac{1}{1+RCs}\]
\[H_{V_R}=\frac{RCs}{1+RCs}\]
\[H_I=-\frac{Cs}{1+RCs}\]
\begin{proof}
Check consistency:
\[\mathcal{L}\{h_{v_C}\}=\frac{1}{RC(s+\frac{1}{RC})}=\frac{1}{1+RCs}\]
\[\mathcal{L}\{h_i\}=\frac{1}{R}\qty(1-\frac{1}{1+RCs})=-\frac{Cs}{1+RCs}\]
\end{proof}
$V_C$ being low-pass filter:
\[\lim_{\omega\to 0}\abs{H_{V_C}(j\omega)}=1\]
\[\lim_{\omega\to\infty}\abs{H_{V_C}(j\omega)}=0\]
\begin{proof}
\[\lim_{\omega\to 0}\abs{H_{V_C}(j\omega)}=\lim_{\omega\to 0}\abs{\frac{1}{1+RCj\omega}}=1\]
\[\lim_{\omega\to\infty}\abs{H_{V_C}(j\omega)}=\lim_{\omega\to\infty}\abs{\frac{1}{1+RCj\omega}}=0\]
\end{proof}
$V_R$ being high-pass filter:
\[\lim_{\omega\to 0}\abs{H_{V_R}(j\omega)}=0\]
\[\lim_{\omega\to\infty}\abs{H_{V_R}(j\omega)}=1\]
\begin{proof}
\[\lim_{\omega\to 0}\abs{H_{V_R}(j\omega)}=\lim_{\omega\to 0}\abs{\frac{RCj\omega}{1+RCj\omega}}=0\]
\[\lim_{\omega\to\infty}\abs{H_{V_R}(j\omega)}=\lim_{\omega\to\infty}\abs{\frac{RCj\omega}{1+RCj\omega}}=1\]
\end{proof}
\sssc{Series LC circuit}
A (lossless) series LC (resonant, oscillator, tank, or tuned) circuit consists of an inductor with inductance $L$, a capacitor with capacitance $C$, and an independent voltage source $v_{in}$ in series connection. Angular resonance/resonant frequency (角共振頻率) $\omega_0$.

Natural response (time domain): Total energy stored in inductor and capacitor $E$.
\[LC\dv[2]{i}{t}+i=0\]
\[\omega_0=\frac{1}{\sqrt{LC}}\]
\[\dv[2]{i}{t}+\omega_0^{\pht{0}2}i=0\]
\[\ba
i&=i(0^-)\cos(\frac{1}{\sqrt{LC}}t)-v_C(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=i(0^-)\cos(\omega_0t)-v_C(0^-)C\omega_0\sin(\omega_0t)
\ea\]
\[\ba
v_C&=-v_L\\
&=i(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)+v_C(0^-)\cos(\frac{1}{\sqrt{LC}}t)\\
&=i(0^-)L\omega_0\sin(\omega_0t)+v_C(0^-)\cos(\omega_0t)
\ea\]
\[\ba
p_C&=-p_L\\
&=\frac{1}{2}\qty((i(0^-))^2\sqrt{\frac{L}{C}}-(v_C(0^-))^2\sqrt{\frac{C}{L}})\sin(\frac{2}{\sqrt{LC}}t)+i(0^-)v_C(0^-)\cos(\frac{2}{\sqrt{LC}}t)\\
&=\frac{1}{2}\qty((i(0^-))^2L\omega_0-(v_C(0^-))^2C\omega_0)\sin(2\omega_0t)+i(0^-)v_C(0^-)\cos(2\omega_0t)
\ea\]
\[\lim_{n\to\infty}\frac{1}{n}\int_0^np_C\dd{t}=-\lim_{n\to\infty}\frac{1}{n}\int_0^np_L\dd{t}=0\]
\[E=\frac{1}{2}\qty(C(v_C(0^-))^2+L(I(0^-))^2)\]
\begin{proof}
\[v_C+v_L=0\]
\[i=C\dv{v_C}{t}\]
\[v_C=-v_L=-L\dv{i}{t}\]
\[LC\dv[2]{i}{t}+i=0\]
\[LCr^2+1=0\]
\[r=\pm\frac{1}{\sqrt{LC}}j\]
\[\omega_0=\frac{1}{\sqrt{LC}}\]
\[\dv[2]{i}{t}+\omega_0^{\pht{0}2}i=0\]
\[i=A\cos(\frac{1}{\sqrt{LC}}t)+B\sin(\frac{1}{\sqrt{LC}}t)\]
\[A=i(0^-)\]
\[L\dv{i}{t}(0^-)+v_C(0^-)=0\]
\[LB\frac{1}{\sqrt{LC}}+v_C(0^-)=0\]
\[B=-v_C(0^-)\sqrt{\frac{C}{L}}=-v_C(0^-)\frac{1}{L\omega_0}\]
\[\ba
i&=i(0^-)\cos(\frac{1}{\sqrt{LC}}t)-v_C(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=i(0^-)\cos(\omega_0t)-v_C(0^-)C\omega_0\sin(\omega_0t)
\ea\]
\[\ba
v_C&=-v_L=-L\dv{i}{t}\\
&=i(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)+v_C(0^-)\cos(\frac{1}{\sqrt{LC}}t)\\
&=i(0^-)L\omega_0\sin(\omega_0t)+v_C(0^-)\cos(\omega_0t)
\ea\]
\[\ba
p_C&=-p_L\\
&=\qty(i(0^-)\cos(\frac{1}{\sqrt{LC}}t)-v_C(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t))\qty(i(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)+v_C(0^-)\cos(\frac{1}{\sqrt{LC}}t))\\
&=(i(0^-))^2\sqrt{\frac{L}{C}}\cos(\frac{1}{\sqrt{LC}}t)\sin(\frac{1}{\sqrt{LC}}t)+i(0^-)v_C(0^-)\cos^2\qty(\frac{1}{\sqrt{LC}}t)-i(0^-)v_C(0^-)\sin^2\qty(\frac{1}{\sqrt{LC}}t)-(v_C(0^-))^2\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)\cos(\frac{1}{\sqrt{LC}}t)\\
&=\frac{1}{2}\qty((i(0^-))^2\sqrt{\frac{L}{C}}-(v_C(0^-))^2\sqrt{\frac{C}{L}})\sin(\frac{2}{\sqrt{LC}}t)+i(0^-)v_C(0^-)\cos(\frac{2}{\sqrt{LC}}t)\\
&=\frac{1}{2}\qty((i(0^-))^2L\omega_0-(v_C(0^-))^2C\omega_0)\sin(2\omega_0t)+i(0^-)v_C(0^-)\cos(2\omega_0t)
\ea\]
\end{proof}
Natural response (Laplace domain):
\[\ba
I&=\frac{LCsi(0^-)-Cv_C(0^-)}{LCs^2+1}\\
&=\frac{si(0^-)-C\omega_0^{\pht{0}2}v_C(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=-V_L\\
&=\frac{LCsv_C(0^-)+Li(0^-)}{LCs^2+1}\\
&=\frac{sv_C(0^-)+L\omega_0^{\pht{0}2}i(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\begin{proof}
\[\ba
I&=\qty(Li(0^-)-\frac{v_C(0^-)}{s})\frac{1}{Ls+\frac{1}{Cs}}\\
&=\frac{LCsi(0^-)-Cv_C(0^-)}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}-2}si(0^-)-Cv_C(0^-)}{\omega_0^{\pht{0}-2}s^2+1}\\
&=\frac{si(0^-)-C\omega_0^{\pht{0}2}v_C(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=-V_L=-LsI+Li(0^-)\\
&=\frac{-L^2Cs^2i(0^-)+LCsv_C(0^-)+L^2Cs^2i(0^-)+Li(0^-)}{LCs^2+1}\\
&=\frac{LCsv_C(0^-)+Li(0^-)}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}-2}sv_C(0^-)+Li(0^-)}{\omega_0^{\pht{0}-2}s^2+1}\\
&=\frac{sv_C(0^-)+L\omega_0^{\pht{0}2}i(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
Check consistency:
\[\ba
\mathcal{L}\{i\}&=i(0^-)\frac{s}{s^2+\frac{1}{LC}}-v_C(0^-)\sqrt{\frac{C}{L}}\frac{\frac{1}{\sqrt{LC}}}{s^2+\frac{1}{LC}}\\
&=\frac{LCsi(0^-)-Cv_C(0^-)}{LCs^2+1}
\ea\]
\[\ba
\mathcal{L}\{v_C\}&=i(0^-)\sqrt{\frac{L}{C}}\frac{\frac{1}{\sqrt{LC}}}{s^2+\frac{1}{LC}}+v_C(0^-)\frac{s}{s^2+\frac{1}{LC}}\\
&=\frac{LCsv_C(0^-)+Li(0^-)}{LCs^2+1}
\ea\]
\end{proof}
Forced response (time domain):
\[LC\dv[2]{i}{t}+i=C\dv{v_{in}}{t}\]
\[\dv[2]{i}{t}+\omega_0^{\pht{0}2}i=\frac{1}{L}\dv{v_{in}}{t}\]
\[\ba
i&=\frac{1}{L}\int_0^t\cos(\frac{1}{\sqrt{LC}}(t-\tau))v_{in}(\tau)\dd{\tau}\\
&=\frac{1}{L}\int_0^t\cos(\omega_0(t-\tau))v_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
v_C&=v_{in}-v_L\\
&=\frac{1}{\sqrt{LC}}\int_0^t\sin(\frac{1}{\sqrt{LC}}(t-\tau))v_{in}(\tau)\dd{\tau}\\
&=\omega_0\int_0^t\sin(\omega_0(t-\tau))v_{in}(\tau)\dd{\tau}
\ea\]
\begin{proof}
\[v_L+v_C=v_{in}\]
\[i=C\dv{v_C}{t}\]
\[v_C=v_{in}-v_L=v_{in}-L\dv{i}{t}\]
\[i=C\dv{v_{in}}{t}-LC\dv[2]{i}{t}\]
\[LC\dv[2]{i}{t}+i=C\dv{v_{in}}{t}\]
\[\dv[2]{i}{t}+\frac{1}{LC}i=\frac{1}{L}\dv{v_{in}}{t}\]
\[\dv[2]{i}{t}+\omega_0^{\pht{0}2}i=\frac{1}{L}\dv{v_{in}}{t}\]
\[i_1=\cos(\frac{1}{\sqrt{LC}}t)\]
\[i_2=\sin(\frac{1}{\sqrt{LC}}t)\]
\[\frac{1}{i_1i_2'-i_2i_1'}=\sqrt{LC}\]
\[\ba
i&=\sqrt{\frac{C}{L}}\qty(-\cos(\frac{1}{\sqrt{LC}}t)\int_0^t\sin(\frac{1}{\sqrt{LC}}\tau)\dv{v_{in}}{\tau}\dd{\tau}+\sin(\frac{1}{\sqrt{LC}}t)\int\cos(\frac{1}{\sqrt{LC}}\tau)\dv{v_{in}}{\tau}\dd{\tau})\\
&=\sqrt{\frac{C}{L}}\qty(-\cos(\frac{1}{\sqrt{LC}}t)\qty(\sin(\frac{1}{\sqrt{LC}}t)(v_{in}-v_{in}(0^-))-\frac{1}{\sqrt{LC}}\int_0^t\cos(\frac{1}{\sqrt{LC}}\tau)v_{in}(\tau)\dd{t})+\sin(\frac{1}{\sqrt{LC}}t)\qty(\cos(\frac{1}{\sqrt{LC}}t)(v_{in}-v_{in}(0^-))+\frac{1}{\sqrt{LC}}\int_0^t\sin(\frac{1}{\sqrt{LC}}\tau)v_{in}(\tau)\dd{\tau}))\\
&=\frac{1}{L}\qty(\cos(\frac{1}{\sqrt{LC}}t)\int_0^t\cos(\frac{1}{\sqrt{LC}}\tau)v_{in}(\tau)\dd{\tau}+\sin(\frac{1}{\sqrt{LC}}t)\int_0^t\sin(\frac{1}{\sqrt{LC}}\tau)v_{in}(\tau)\dd{\tau})\\
&=\frac{1}{L}\int_0^t\qty(\cos(\frac{1}{\sqrt{LC}}t)\cos(\frac{1}{\sqrt{LC}}\tau)+\sin(\frac{1}{\sqrt{LC}}t)\sin(\frac{1}{\sqrt{LC}}\tau))v_{in}(\tau)\dd{\tau}\\
&=\frac{1}{L}\int_0^t\cos(\frac{1}{\sqrt{LC}}(t-\tau))v_{in}(\tau)\dd{\tau}\\
&=\frac{1}{L}\int_0^t\cos(\omega_0(t-\tau))v_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
v_C&=v_{in}-v_L=v_{in}-L\dv{i}{t}\\
&=v_{in}-\cos(0^-)v_{in}-\int_0^t\pdv{}{t}\qty(\cos(\frac{1}{\sqrt{LC}}(t-\tau))v_{in}(\tau))\dd{\tau}\\
&=\frac{1}{\sqrt{LC}}\int_0^t\sin(\frac{1}{\sqrt{LC}}(t-\tau))v_{in}(\tau)\dd{\tau}\\
&=\omega_0\int_0^t\sin(\omega_0(t-\tau))v_{in}(\tau)\dd{\tau}
\ea\]
\end{proof}
Forced response (Laplace domain):
\[\ba
I&=\frac{CsV_{in}}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}CsV_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=\frac{V_{in}}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}V_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_L&=\frac{LCs^2V_{in}}{LCs^2+1}\\
&=\frac{s^2V_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\begin{proof}
\[\ba
I&=\frac{V_{in}}{Ls+\frac{1}{Cs}}\\
&=\frac{CsV_{in}}{LCs^2+1}\\
&=\frac{CsV_{in}}{\omega_0^{\pht{0}-2}s^2+1}\\
&=\frac{\omega_0^{\pht{0}2}CsV_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_L&=\frac{LCs^2V_{in}}{LCs^2+1}\\
&=\frac{s^2V_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=\frac{V_{in}}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}V_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
Check consistency:
\[\mathcal{L}\{i\}=\frac{1}{L}\frac{s}{s^2+\frac{1}{LC}}V_{in}=\frac{CsV_{in}}{LCs^2+1}\]
\[\mathcal{L}\{v_C\}=\frac{1}{\sqrt{LC}}\frac{\frac{1}{\sqrt{LC}}}{s^2+\frac{1}{LC}}V_{in}=\frac{V_{in}}{LCs^2+1}\]
\end{proof}
Total response (time domain):
\[\ba
i&=i(0^-)\cos(\frac{1}{\sqrt{LC}}t)-v_C(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+\frac{1}{L}\int_0^t\cos(\frac{1}{\sqrt{LC}}(t-\tau))v_{in}(\tau)\dd{\tau}\\
&=i(0^-)\cos(\omega_0t)-v_C(0^-)C\omega_0\sin(\omega_0t)+\frac{1}{L}\int_0^t\cos(\omega_0(t-\tau))v_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
v_C&=v_{in}-v_L\\
&=i(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)+v_C(0^-)\cos(\frac{1}{\sqrt{LC}}t)+\frac{1}{\sqrt{LC}}\int_0^t\sin(\frac{1}{\sqrt{LC}}(t-\tau))v_{in}(\tau)\dd{\tau}\\
&=i(0^-)L\omega_0\sin(\omega_0t)+v_C(0^-)\cos(\omega_0t)+\omega_0\int_0^t\sin(\omega_0(t-\tau))v_{in}(\tau)\dd{\tau}
\ea\]
Total response (Laplace domain):
\[\ba
I&=\frac{LCsi(0^-)-Cv_C(0^-)+CsV_{in}}{LCs^2+1}\\
&=\frac{si(0^-)-C\omega_0^{\pht{0}2}v_C(0^-)+\omega_0^{\pht{0}2}CsV_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=\frac{LCsv_C(0^-)+Li(0^-)+V_{in}}{LCs^2+1}\\
&=\frac{sv_C(0^-)+L\omega_0^{\pht{0}2}i(0^-)+\omega_0^{\pht{0}2}V_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_L&=\frac{LCs^2V_{in}-LCsv_C(0^-)-Li(0^-)}{LCs^2+1}\\
&=\frac{s^2V_{in}-sv_C(0^-)-L\omega_0^{\pht{0}2}i(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
Steady state (time domain):
\[v_C=v_{in}\]
\[v_L=0\]
\[i=0\]
Constant source forced response (time domain):
\[\ba
i&=v_{in}\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=v_{in}C\omega_0\sin(\omega_0t)
\ea\]
\[\ba
v_C&=v_{in}-v_L\\
&=v_{in}\cos(\frac{1}{\sqrt{LC}}t)\\
&=v_{in}\cos(\omega_0t)
\ea\]
Constant source total response (time domain):
\[\ba
i&=i(0^-)\cos(\frac{1}{\sqrt{LC}}t)+\qty(v_{in}-v_C(0^-))\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=i(0^-)\cos(\omega_0t)+\qty(v_{in}-v_C(0^-))C\omega_0\sin(\omega_0t)
\ea\]
\[\ba
v_C&=v_{in}-v_L\\
&=i(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)+\qty(v_{in}+v_C(0^-))\cos(\frac{1}{\sqrt{LC}}t)\\
&=i(0^-)L\omega_0\sin(\omega_0t)+\qty(v_{in}+v_C(0^-))\cos(\omega_0t)
\ea\]
Resonance state (time domain): Maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[v_{in}=v_m\cos(\omega_0t+\theta)\]
\[i_m=i(0^-)=\infty\]
\[v_C(0^-)=0\]
\[i=i_m\cos(\omega_0t+\theta)\]
\[v_C=-v_L=\frac{i_m}{C\omega_0}\sin(\omega_0t+\theta)=i_mL\omega_0\sin(\omega_0t+\theta)\]
\[E_m=\frac{Li_m^{\pht{m}2}}{2}\]
\[E_l=\frac{v_mi_m\pi}{\omega_0}\]
\[Q=\frac{Li_m\omega_0}{v_m}=\frac{i_m}{v_m}\sqrt{\frac{L}{C}}\]
Resonance state (phasor domain):
\[\mb{V}_{in}=v_me^{j\theta}\]
\[\mb{I}=i_me^{j\theta},\quad i_m=\infty\]
\[\mb{V}_C=-\mb{V}_L=-\frac{ji_m}{C\omega_0}e^{j\theta}=-ji_mL\omega_0e^{j\theta}\]
Impulse response:
\[\ba
h_i&=\frac{1}{L}\cos(\frac{1}{\sqrt{LC}}t)u(t)\\
&=\frac{1}{L}\cos(\omega_0t)u(t)
\ea\]
\[\ba
h_{v_C}&=\delta(t)-h_{v_L}\\
&=\frac{1}{\sqrt{LC}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=\omega_0\sin(\omega_0t)
\ea\]
Transfer function:
\[\ba
H_I&=\frac{Cs}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}Cs}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{V_C}&=\frac{1}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{V_L}&=\frac{LCs^2}{LCs^2+1}\\
&=\frac{s^2}{s^2+\omega_0^{\pht{0}2}}
\ea\]
$V_C$ being low-pass filter:
\[\lim_{\omega\to 0}\abs{H_{V_C}(j\omega)}=1\]
\[\lim_{\omega\to\infty}\abs{H_{V_C}(j\omega)}=0\]
\begin{proof}
\[\lim_{\omega\to 0}\abs{H_{V_C}(j\omega)}=\lim_{\omega\to 0}\abs{\frac{1}{1-LC\omega^2}}=1\]
\[\lim_{\omega\to\infty}\abs{H_{V_C}(j\omega)}=\lim_{\omega\to\infty}\abs{\frac{1}{1-LC\omega^2}}=0\]
\end{proof}
$V_L$ being high-pass filter:
\[\lim_{\omega\to 0}\abs{H_{V_L}(j\omega)}=0\]
\[\lim_{\omega\to\infty}\abs{H_{V_L}(j\omega)}=1\]
\begin{proof}
\[\lim_{\omega\to 0}\abs{H_{V_L}(j\omega)}=\lim_{\omega\to 0}\abs{\frac{-LC\omega^2}{1-LC\omega^2}}=0\]
\[\lim_{\omega\to\infty}\abs{H_{V_L}(j\omega)}=\lim_{\omega\to\infty}\abs{\frac{-LC\omega^2}{1-LC\omega^2}}=1\]
\end{proof}
\sssc{Parallel LC circuit}
A (lossless) parallel LC (resonant, oscillator, tank, or tuned) circuit consists of an inductor with inductance $L$, a capacitor with capacitance $C$, and an independent current source $i_{in}$ in parallel connection. Angular resonance/resonant frequency $\omega_0$.

Natural response (time domain): Total energy stored in inductor and capacitor $E$.
\[LC\dv[2]{v}{t}+v=0\]
\[\omega_0=\frac{1}{\sqrt{LC}}\]
\[\dv[2]{v}{t}+\omega_0^{\pht{0}2}v=0\]
\[\ba
v&=v(0^-)\cos(\frac{1}{\sqrt{LC}}t)-i_L(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=v(0^-)\cos(\omega_0t)-i_L(0^-)L\omega_0\sin(\omega_0t)
\ea\]
\[\ba
i_L&=-i_C\\
&=v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+i_L(0^-)\cos(\frac{1}{\sqrt{LC}}t)\\
&=v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+i_L(0^-)\cos(\frac{1}{\sqrt{LC}}t)
\ea\]
\[\ba
p_L&=-p_C\\
&=\frac{1}{2}\qty((v(0^-))^2\sqrt{\frac{C}{L}}-(i_L(0^-))^2)\sin(\frac{2}{\sqrt{LC}}t)+v(0^-)i_L(0^-)\cos(\frac{2}{\sqrt{LC}}t)\\
&=\frac{1}{2}\qty((v(0^-))^2C\omega_0-(i_L(0^-))^2)\sin(2\omega_0t)+v(0^-)i_L(0^-)\cos(2\omega_0t)
\ea\]
\[\lim_{n\to\infty}\frac{1}{n}\int_0^np_C\dd{t}=-\lim_{n\to\infty}\frac{1}{n}\int_0^np_L\dd{t}=0\]
\[E=\frac{1}{2}\qty(C(v_C(0^-))^2+L(I(0^-))^2)\]
\begin{proof}
\[i_L+i_C=0\]
\[v=L\dv{i_L}{t}\]
\[i_L=-i_C=-C\dv{v}{t}\]
\[LC\dv[2]{v}{t}+v=0\]
\[LCr^2+1=0\]
\[r=\pm\frac{1}{\sqrt{LC}}j\]
\[\omega_0=\frac{1}{\sqrt{LC}}\]
\[\dv[2]{v}{t}+\omega_0^{\pht{0}2}v=0\]
\[v=A\cos(\frac{1}{\sqrt{LC}}t)+B\sin(\frac{1}{\sqrt{LC}}t)\]
\[A=v(0^-)\]
\[i_L=v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)-B\sqrt{\frac{C}{L}}\cos(\frac{1}{\sqrt{LC}}t)\]
\[B=-i_L(0^-)\sqrt{\frac{L}{C}}\]
\[\ba
v&=v(0^-)\cos(\frac{1}{\sqrt{LC}}t)-i_L(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=v(0^-)\cos(\omega_0t)-i_L(0^-)L\omega_0\sin(\omega_0t)
\ea\]
\[\ba
i_L&=-i_C=-C\dv{v}{t}\\
&=v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+i_L(0^-)\cos(\frac{1}{\sqrt{LC}}t)\\
&=v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+i_L(0^-)\cos(\frac{1}{\sqrt{LC}}t)
\ea\]
\[\ba
p_L&=-p_C\\
&=\qty(v(0^-)\cos(\frac{1}{\sqrt{LC}}t)-i_L(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t))\qty(v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+i_L(0^-)\cos(\frac{1}{\sqrt{LC}}t))\\
&=(v(0^-))^2\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)\cos(\frac{1}{\sqrt{LC}}t)+v(0^-)i_L(0^-)\cos^2\qty(\frac{1}{\sqrt{LC}}t)-v(0^-)i_L(0^-)\sin^2\qty(\frac{1}{\sqrt{LC}}t)-(i_L(0^-))^2\sin(\frac{1}{\sqrt{LC}}t)\cos(\frac{1}{\sqrt{LC}}t)\\
&=\frac{1}{2}\qty((v(0^-))^2\sqrt{\frac{C}{L}}-(i_L(0^-))^2)\sin(\frac{2}{\sqrt{LC}}t)+v(0^-)i_L(0^-)\cos(\frac{2}{\sqrt{LC}}t)\\
&=\frac{1}{2}\qty((v(0^-))^2C\omega_0-(i_L(0^-))^2)\sin(2\omega_0t)+v(0^-)i_L(0^-)\cos(2\omega_0t)
\ea\]
\end{proof}
Natural response (Laplace domain):
\[\ba
V&=\frac{LCsv(0^-)-Li_L(0^-)}{LCs^2+1}\\
&=\frac{sv(0^-)-L\omega_0^{\pht{0}2}i_L(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=-I_C\\
&=\frac{Cv(0^-)+LCsi_L(0^-)}{LCs^2+1}\\
&=\frac{C\omega_0^{\pht{0}2}v(0^-)+si_L(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\begin{proof}
\[I_L+I_C=0\]
\[\ba
V&=\frac{Cv(0^-)-\frac{i_L(0^-)}{s}}{\frac{1}{Ls}+Cs}\\
&=\frac{LCsv(0^-)-Li_L(0^-)}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}-2}sv(0^-)-Li_L(0^-)}{\omega_0^{\pht{0}-2}s^2+1}\\
&=\frac{sv(0^-)-L\omega_0^{\pht{0}2}i_L(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=-I_C\\
&=\frac{V}{Ls}+\frac{i_L(0^-)}{s}\\
&=\frac{Csv(0^-)-i_L(0^-)+LCs^2i_L(0^-)+i_L(0^-)}{LCs^3+s}\\
&=\frac{Cv(0^-)+LCsi_L(0^-)}{LCs^2+1}\\
&=\frac{Cv(0^-)+\omega_0^{\pht{0}-2}si_L(0^-)}{\omega_0^{\pht{0}-2}s^2+1}\\
&=\frac{C\omega_0^{\pht{0}2}v(0^-)+si_L(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
Check consistency:
\[\ba
\mathcal{L}\{V\}&=v(0^-)\frac{s}{s^2+\frac{1}{LC}}-i_L(0^-)\sqrt{\frac{L}{C}}\frac{\frac{1}{\sqrt{LC}}}{s^2+\frac{1}{LC}}\\
&=\frac{LCsv(0^-)-Li_L(0^-)}{LCs^2+1}
\ea\]
\[\ba
\mathcal{L}\{i_L\}&=v(0^-)\sqrt{\frac{C}{L}}\frac{\frac{1}{\sqrt{LC}}}{s^2+\frac{1}{LC}}+i_L(0^-)\frac{s}{s^2+\frac{1}{LC}}\\
\ea\]
\end{proof}
Forced response (time domain):
\[LC\dv[2]{v}{t}+v=\dv{i_{in}}{t}\]
\[\dv[2]{v}{t}+\omega_0^{\pht{0}2}v=\omega_0^{\pht{0}2}\dv{i_{in}}{t}\]
\[\ba
v&=\frac{1}{C}\int_0^t\cos(\frac{1}{\sqrt{LC}}(t-\tau))i_{in}(\tau)\dd{\tau}\\
&=\frac{1}{C}\int_0^t\cos(\omega_0(t-\tau))i_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
i_L&=i_{in}-i_C\\
&=\frac{1}{\sqrt{LC}}\int_0^t\sin(\frac{1}{\sqrt{LC}}(t-\tau))i_{in}(\tau)\dd{\tau}\\
&=\omega_0\int_0^t\sin(\omega_0(t-\tau))i_{in}(\tau)\dd{\tau}
\ea\]
\begin{proof}
\[i_L+i_C=i_{in}\]
\[v=L\dv{i_L}{t}\]
\[i_L=i_{in}-i_C=i_{in}-C\dv{v}{t}\]
\[v=L\dv{i_{in}}{t}-LC\dv[2]{v}{t}\]
\[LC\dv[2]{v}{t}+v=\dv{i_{in}}{t}\]
\[\dv[2]{v}{t}+\frac{v}{LC}=\frac{1}{C}\dv{i_{in}}{t}\]
\[\dv[2]{v}{t}+\omega_0^{\pht{0}2}v=\omega_0^{\pht{0}2}\dv{i_{in}}{t}\]
\[v_1=\cos(\frac{1}{\sqrt{LC}}t)\]
\[v_2=\sin(\frac{1}{\sqrt{LC}}t)\]
\[\frac{1}{v_1v_2'-v_2v_1'}=\sqrt{LC}\]
\[\ba
v&=\sqrt{\frac{L}{C}}\qty(-\cos(\frac{1}{\sqrt{LC}}t)\int_0^t\sin(\frac{1}{\sqrt{LC}}\tau)\dv{i_{in}}{\tau}\dd{\tau}+\sin(\frac{1}{\sqrt{LC}}t)\int\cos(\frac{1}{\sqrt{LC}}\tau)\dv{i_{in}}{\tau}\dd{\tau})\\
&=\sqrt{\frac{L}{C}}\qty(-\cos(\frac{1}{\sqrt{LC}}t)\qty(\sin(\frac{1}{\sqrt{LC}}t)(i_{in}-i_{in}(0^-))-\frac{1}{\sqrt{LC}}\int_0^t\cos(\frac{1}{\sqrt{LC}}\tau)i_{in}(\tau)\dd{t})+\sin(\frac{1}{\sqrt{LC}}t)\qty(\cos(\frac{1}{\sqrt{LC}}t)(i_{in}-i_{in}(0^-))+\frac{1}{\sqrt{LC}}\int_0^t\sin(\frac{1}{\sqrt{LC}}\tau)i_{in}(\tau)\dd{\tau}))\\
&=\frac{1}{C}\cos(\frac{1}{\sqrt{LC}}t)\int_0^t\cos(\frac{1}{\sqrt{LC}}\tau)i_{in}(\tau)\dd{\tau}+\frac{1}{C}\sin(\frac{1}{\sqrt{LC}}t)\int_0^t\sin(\frac{1}{\sqrt{LC}}\tau)i_{in}(\tau)\dd{\tau}\\
&=\frac{1}{C}\qty(\cos(\frac{1}{\sqrt{LC}}t)\int_0^t\cos(\frac{1}{\sqrt{LC}}\tau)i_{in}(\tau)\dd{\tau}+\sin(\frac{1}{\sqrt{LC}}t)\int_0^t\sin(\frac{1}{\sqrt{LC}}\tau)i_{in}(\tau)\dd{\tau})\\
&=\frac{1}{C}\int_0^t\qty(\cos(\frac{1}{\sqrt{LC}}t)\cos(\frac{1}{\sqrt{LC}}\tau)+\sin(\frac{1}{\sqrt{LC}}t)\sin(\frac{1}{\sqrt{LC}}\tau))i_{in}(\tau)\dd{\tau}\\
&=\frac{1}{C}\int_0^t\cos(\frac{1}{\sqrt{LC}}(t-\tau))i_{in}(\tau)\dd{\tau}\\
&=\frac{1}{C}\int_0^t\cos(\omega_0(t-\tau))i_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
i_L&=i_{in}-i_C=i_{in}-C\dv{v}{t}\\
&=i_{in}-\cos(0^-)i_{in}-\int_0^t\pdv{}{t}\qty(\cos(\frac{1}{\sqrt{LC}}(t-\tau))i_{in}(\tau))\dd{\tau}\\
&=\frac{1}{\sqrt{LC}}\int_0^t\sin(\frac{1}{\sqrt{LC}}(t-\tau))i_{in}(\tau)\dd{\tau}\\
&=\omega_0\int_0^t\sin(\omega_0(t-\tau))i_{in}(\tau)\dd{\tau}
\ea\]
\end{proof}
Forced response (Laplace domain):
\[\ba
V&=\frac{LsI_{in}}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}LsI_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=\frac{I_{in}}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}I_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_C&=\frac{LCs^2I_{in}}{LCs^2+1}\\
&=\frac{s^2I_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\begin{proof}
\[\ba
V&=\frac{I_{in}}{\frac{1}{Ls}+Cs}\\
&=\frac{LsI_{in}}{LCs^2+1}\\
&=\frac{LsI_{in}}{\omega_0^{\pht{0}-2}s^2+1}\\
&=\frac{\omega_0^{\pht{0}2}LsI_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=\frac{I_{in}}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}I_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_C&=\frac{LCs^2I_{in}}{LCs^2+1}\\
&=\frac{s^2I_{in}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
Check consistency:
\[\mathcal{L}\{v\}=\frac{1}{C}\frac{s}{s^2+\frac{1}{LC}}I_{in}=\frac{LsI_{in}}{LCs^2+1}\]
\[\mathcal{L}\{i_L\}=\frac{1}{\sqrt{LC}}\frac{\frac{1}{\sqrt{LC}}}{s^2+\frac{1}{LC}}I_{in}=\frac{I_{in}}{LCs^2+1}\]
\end{proof}
Total response (time domain):
\[\ba
v&=\frac{1}{C}\int_0^t\cos(\frac{1}{\sqrt{LC}}(t-\tau))i_{in}(\tau)\dd{\tau}+v(0^-)\cos(\frac{1}{\sqrt{LC}}t)-i_L(0^-)\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=\frac{1}{C}\int_0^t\cos(\omega_0(t-\tau))i_{in}(\tau)\dd{\tau}+v(0^-)\cos(\omega_0t)-i_L(0^-)L\omega_0\sin(\omega_0t)
\ea\]
\[\ba
i_L&=i_{in}-i_C\\
&=\frac{1}{\sqrt{LC}}\int_0^t\sin(\frac{1}{\sqrt{LC}}(t-\tau))i_{in}(\tau)\dd{\tau}+v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+i_L(0^-)\cos(\frac{1}{\sqrt{LC}}t)\\
&=\omega_0\int_0^t\sin(\omega_0(t-\tau))i_{in}(\tau)\dd{\tau}+v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+i_L(0^-)\cos(\frac{1}{\sqrt{LC}}t)
\ea\]
Total response (Laplace domain):
\[\ba
V&=\frac{LsI_{in}+LCsv(0^-)-Li_L(0^-)}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}LsI_{in}+sv(0^-)-L\omega_0^{\pht{0}2}i_L(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=\frac{I_{in}+Cv(0^-)+LCsi_L(0^-)}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}I_{in}+C\omega_0^{\pht{0}2}v(0^-)+si_L(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_C&=\frac{LCs^2I_{in}-Cv(0^-)-LCsi_L(0^-)}{LCs^2+1}\\
&=\frac{s^2I_{in}-C\omega_0^{\pht{0}2}v(0^-)-si_L(0^-)}{s^2+\omega_0^{\pht{0}2}}
\ea\]
Steady state (time domain):
\[i_L=i_{in}\]
\[i_C=0\]
\[v=0\]
Constant source forced response (time domain):
\[\ba
v&=i_{in}\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=i_{in}L\omega_0\sin(\omega_0t)
\ea\]
\[\ba
i_L&=i_{in}-i_C\\
&=-i_{in}\cos(\frac{1}{\sqrt{LC}}t)\\
&=-i_{in}\cos(\omega_0t)
\ea\]
Constant source total response (time domain):
\[\ba
v&=v(0^-)\cos(\frac{1}{\sqrt{LC}}t)-\qty(i_{in}-i_L(0^-))\sqrt{\frac{L}{C}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=v(0^-)\cos(\omega_0t)+\qty(i_{in}-i_L(0^-))L\omega_0\sin(\omega_0t)
\ea\]
\[\ba
i_L&=i_{in}-i_C\\
&=v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)-\qty(i_{in}-i_L(0^-))\cos(\frac{1}{\sqrt{LC}}t)\\
&=v(0^-)\sqrt{\frac{C}{L}}\sin(\frac{1}{\sqrt{LC}}t)+\qty(i_{in}-i_L(0^-))\cos(\omega_0t)
\ea\]
Resonance state (time domain): Maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[i_{in}=i_m\cos(\omega_0t+\theta)\]
\[v(0^-)=v_m=\infty\]
\[v=v_m\cos(\omega_0t+\theta)\]
\[i_L(0^-)=0\]
\[i_C=-i_L=-v_mC\omega_0\sin(\omega_0t+\theta)=\frac{v_m}{L\omega_0}\sin(\omega_0t+\theta)\]
\[E_m=\frac{Cv_m^{\pht{m}2}}{2}\]
\[E_l=\frac{v_mi_m\pi}{\omega_0}\]
\[Q=\frac{Cv_m\omega_0}{i_m}=\frac{v_m}{i_m}\sqrt{\frac{C}{L}}\]
Resonance state (phasor domain):
\[\mb{I}_{in}=i_me^{j\theta}\]
\[\mb{V}=v_me^{j\theta},\quad v_m=\infty\]
\[\mb{I}_C=-\mb{I}_L=-jv_mC\omega_0e^{j\theta}=-\frac{jv_m}{L\omega_0}e^{j\theta}\]
Impulse response:
\[\ba
h_i&=\frac{1}{C}\cos(\frac{1}{\sqrt{LC}}t)u(t)\\
&=\frac{1}{C}\cos(\omega_0t)u(t)
\ea\]
\[\ba
h_{i_L}&=\delta(t)-h_{i_C}\\
&=\frac{1}{\sqrt{LC}}\sin(\frac{1}{\sqrt{LC}}t)\\
&=\omega_0\sin(\omega_0t)
\ea\]
Transfer function:
\[\ba
H_V&=\frac{Ls}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}Ls}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{I_L}&=\frac{1}{LCs^2+1}\\
&=\frac{\omega_0^{\pht{0}2}}{s^2+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{I_C}&=\frac{LCs^2}{LCs^2+1}\\
&=\frac{s^2}{s^2+\omega_0^{\pht{0}2}}
\ea\]
$I_L$ being low-pass filter:
\[\lim_{\omega\to 0}\abs{H_{I_L}(j\omega)}=1\]
\[\lim_{\omega\to\infty}\abs{H_{I_L}(j\omega)}=0\]
\begin{proof}
\[\lim_{\omega\to 0}\abs{H_{I_L}(j\omega)}=\lim_{\omega\to 0}\abs{\frac{1}{1-LC\omega^2}}=1\]
\[\lim_{\omega\to\infty}\abs{H_{I_L}(j\omega)}=\lim_{\omega\to\infty}\abs{\frac{1}{1-LC\omega^2}}=0\]
\end{proof}
$I_C$ being high-pass filter:
\[\lim_{\omega\to 0}\abs{H_{I_C}(j\omega)}=0\]
\[\lim_{\omega\to\infty}\abs{H_{I_C}(j\omega)}=1\]
\begin{proof}
\[\lim_{\omega\to 0}\abs{H_{I_C}(j\omega)}=\lim_{\omega\to 0}\abs{\frac{-LC\omega^2}{1-LC\omega^2}}=0\]
\[\lim_{\omega\to\infty}\abs{H_{I_C}(j\omega)}=\lim_{\omega\to\infty}\abs{\frac{-LC\omega^2}{1-LC\omega^2}}=1\]
\end{proof}
\sssc{Series RLC circuit}
A series RLC (oscillator) circuit consists of a resistor with resistance $R$, an inductor with inductance $L$, a capacitor with capacitance $C$, and an independent voltage source $v_{in}$ in series connection. Neper frequency or attenuation $\alpha$, angular resonance/resonant frequency $\omega_0$, damping factor/ratio $\zeta$, characteristic roots $r_{1,2}$, critical resistance $R_c$ (the resistance for critically damped response), damping angular frequency $\omega_d$, $t_n=\frac{2\pi n}{\omega}$, stored energy in the inductor and capacitor $E_L$ and $E_C$, $E=E_L+E_C$, dissipated energy of the resistor in $E_R$.

Natural response (time domain):
\[\dv[2]{i}{t}+\frac{R}{L}\dv{i}{t}+\frac{i}{LC}=0\]
\[\alpha=\frac{R}{2L}\]
\[\omega_0=\frac{1}{\sqrt{LC}}\]
\[\zeta=\frac{R}{2}\sqrt{\frac{C}{L}}\]
\[R_c=2\sqrt{\frac{L}{C}}\]
\[\omega_d=\omega_0\sqrt{1-\zeta^2}\]
\[\dv[2]{i}{t}+2\omega_0\zeta\dv{i}{t}+\omega_0^{\pht{0}2}i=0\]
\[r_{1,2}=-\omega_0\qty(\zeta\pm\sqrt{\zeta^2-1})\]
\begin{proof}
\[v_R+v_C+v_L=0\]
\[v_R=Ri\]
\[i=C\dv{v_C}{t}\]
\[v_L=L\dv{i}{t}\]
\[R\dv{i}{t}+\frac{i}{C}+L\dv[2]{i}{t}=0\]
\[\dv[2]{i}{t}+\frac{R}{L}\dv{i}{t}+\frac{i}{LC}=0\]
\[\alpha=\frac{R}{2L}\]
\[\omega_0=\frac{1}{\sqrt{LC}}\]
\[\zeta=\frac{\alpha}{\omega_0}=\frac{R}{2}\sqrt{\frac{C}{L}}\]
\[\dv[2]{i}{t}+2\omega_0\zeta\dv{i}{t}+\omega_0^{\pht{0}2}i=0\]
\[r^2+2\omega_0\zeta r+\omega_0^{\pht{0}2}=0\]
\[\ba
r_{1,2}&=\frac{-2\omega_0\zeta\pm\sqrt{4\omega_0^{\pht{0}2}\zeta^2-4\omega_0^{\pht{0}2}}}{2}\\
&=-\omega_0\qty(\zeta\pm\sqrt{\zeta^2-1})
\ea\]
\end{proof}
\bit
\item $\zeta>1$ Overdamped response:
\[i=-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_R=-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_L=\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_C=\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\begin{proof}
\[i=Ae^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+Be^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i(0^-)=A+B\]
\[v_R=ARe^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+BRe^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[\ba
v_L&=L\dv{i}{t}\\
&=-AR\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-BR\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}
\ea\]
\[\ba
v_C&=-v_R-v_L\\
&=-ARe^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-BRe^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}+AR\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+BR\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\\
&=-AR\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-BR\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}
\ea\]
\[\ba
v_C(0^-)&=-AR\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}-BR\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}\\
&=-AR\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}-i(0^-)R\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}+AR\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}\\
&=\frac{-i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})-2AR\sqrt{\zeta^2-1}}{2\zeta}
\ea\]
\[A=-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}\]
\[B=i(0^-)-A=\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}\]
\[i=-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[\ba
v_C&=\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}R\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}R\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\\
&=\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}
\ea\]
Check $i=C\dv{v_C}{t}$:
\[\ba
C\dv{v_C}{t}&=-\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}\frac{2\zeta}{R}\qty(\zeta-\sqrt{\zeta^2-1})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}\frac{2\zeta}{R}\qty(\zeta+\sqrt{\zeta^2-1})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\\
&=-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}
\ea\]
\[\ba
v_L&=\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2\sqrt{\zeta^2-1}}\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2\sqrt{\zeta^2-1}}\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\\
&=\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}
\ea\]
\end{proof}
\item $\zeta=1$ Critically damped response:
\[i=\qty(i(0^-)-\qty(i(0^-)+2\frac{v_C(0^-)}{R})\omega_0t)e^{-\omega_0t}\]
\[v_R=\qty(i(0^-)R-\qty(i(0^-)R+2v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\[v_L=-\qty(i(0^-)R+v_C(0^-)+\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\[v_C=\qty(v_C(0^-)+\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\begin{proof}
\[i=(A+Bt)e^{-\omega_0t}\]
\[A=i(0^-)\]
\[i=(i(0^-)+Bt)e^{-\omega_0t}\]
\[v_R=(i(0^-)+Bt)Re^{-\omega_0t}\]
\[\ba
v_L&=L\dv{i}{t}\\
&=L\qty(-(i(0^-)+Bt)\omega_0+B)e^{-\omega_0t}\\
&=\qty(-i(0^-)\frac{R}{2}+\frac{BR}{2\omega_0}-\frac{BR}{2}t)e^{-\omega_0t}
\ea\]
\[\ba
v_C&=-v_R-v_L\\
&=\qty(-i(0^-)R-BRt+i(0^-)\frac{R}{2}-\frac{BR}{2\omega_0}+\frac{BR}{2}t)e^{-\omega_0t}\\
&=\qty(-i(0^-)\frac{R}{2}-\frac{BR}{2\omega_0}-\frac{BR}{2}t)e^{-\omega_0t}
\ea\]
\[v_C(0^-)=-i(0^-)\frac{R}{2}-\frac{BR}{2\omega_0}\]
\[\ba
B&=-\qty(i(0^-)\frac{R}{2}+v_C(0^-))\frac{2\omega_0}{R}\\
&=-\frac{\qty(i(0^-)R+2v_C(0^-))\omega_0}{R}\\
&=-\qty(i(0^-)+2\frac{v_C(0^-)}{R})\omega_0
\ea\]
\[i=\qty(i(0^-)-\qty(i(0^-)+2\frac{v_C(0^-)}{R})\omega_0t)e^{-\omega_0t}\]
\[\ba
v_C&=\qty(-i(0^-)\frac{R}{2}+\frac{i(0^-)R\omega_0+2v_C(0^-)\omega_0}{2\omega_0}+\frac{i(0^-)R\omega_0+2v_C(0^-)\omega_0}{2}t)e^{-\omega_0t}\\
&=\qty(v_C(0^-)+\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0t)e^{-\omega_0t}
\ea\]
Check $i=C\dv{v_C}{t}$:
\[\ba
C\dv{v_C}{t}&=\qty(-v_C(0^-)\frac{2}{R}+\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\frac{2}{R}-\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\frac{2}{R}\omega_0t)e^{-\omega_0t}\\
&=\qty(i(0^-)-\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\frac{2}{R}\omega_0t)e^{-\omega_0t}\\
&=(i(0^-)-\qty(i(0^-)+2\frac{v_C(0^-)}{R})\omega_0t)e^{-\omega_0t}
\ea\]
\[v_R=\qty(i(0^-)R-\qty(i(0^-)R+2v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\[v_L=-\qty(i(0^-)R+v_C(0^-)+\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\end{proof}
\item $0<\zeta<1$ Underdamped response:
\[i=e^{-\omega_0\zeta t}\qty(i(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(2\frac{v_C(0^-)}{R}+i(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_R=e^{-\omega_0\zeta t}\qty(i(0^-)R\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(2v_C(0^-)+i(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_L=e^{-\omega_0\zeta t}\qty(-\qty(v_C(0^-)+i(0^-)R)\cos(\omega_0\sqrt{1-\zeta^2}t)+\frac{v_C(0^-)\zeta+\frac{1}{2}i(0^-)R\frac{2\zeta^2-1}{\zeta}}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_C=e^{-\omega_0\zeta t}\qty(v_C(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(v_C(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}}+\frac{1}{2}\frac{i(0^-)R}{\zeta\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[\omega=\omega_0\sqrt{1-\zeta^2}\]
\[t_n=\frac{2\pi n}{\omega_0\sqrt{1-\zeta^2}}\]
\[i(t_n)=e^{-\omega_0\zeta t_n}i(0^-)\]
\[v_C(t_n)=e^{-\omega_0\zeta t_n}v_C(0^-)\]
\[E_L(t_n)=\frac{1}{2}L\qty(i(0^-))^2e^{-2\omega_0\zeta t_n}\]
\[E_C(t_n)=\frac{1}{2}C\qty(v_C(0^-))^2e^{-2\omega_0\zeta t_n}\]
\[E(t_n)=\qty(\frac{1}{2}L\qty(i(0^-))^2+\frac{1}{2}C\qty(v_C(0^-))^2)e^{-2\omega_0\zeta t_n}\]
\[E_R(t_n)=\qty(\frac{1}{2}L\qty(i(0^-))^2+\frac{1}{2}C\qty(v_C(0^-))^2)\qty(1-e^{-2\omega_0\zeta t_n})\]
\begin{proof}
\[i=e^{-\omega_0\zeta t}\qty(A\cos(\omega_0\sqrt{1-\zeta^2}t)+B\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[A=i(0^-)\]
\[i=e^{-\omega_0\zeta t}\qty(i(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+B\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_R=Re^{-\omega_0\zeta t}\qty(i(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+B\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[\ba
v_L&=L\dv{i}{t}\\
&=-\frac{R}{2\zeta}\zeta e^{-\omega_0\zeta t}\qty(i(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+B\sin(\omega_0\sqrt{1-\zeta^2}t))+\frac{R}{2\zeta}\sqrt{1-\zeta^2}e^{-\omega_0\zeta t}\qty(-i(0^-)\sin(\omega_0\sqrt{1-\zeta^2}t)+B\cos(\omega_0\sqrt{1-\zeta^2}t))\\
&=\frac{R}{2\zeta}e^{-\omega_0\zeta t}\qty(\qty(B\sqrt{1-\zeta^2}-i(0^-)\zeta)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(B\zeta+i(0^-)\sqrt{1-\zeta^2})\sin(\omega_0\sqrt{1-\zeta^2}t))
\ea\]
\[\ba
v_C&=-v_R-v_L\\
&=\frac{R}{2\zeta}e^{-\omega_0\zeta t}\qty(\qty(-B\sqrt{1-\zeta^2}+i(0^-)\zeta-2i(0^-)\zeta)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(B\zeta+i(0^-)\sqrt{1-\zeta^2}-2B\zeta)\sin(\omega_0\sqrt{1-\zeta^2}t))\\
&=\frac{R}{2\zeta}e^{-\omega_0\zeta t}\qty(-\qty(B\sqrt{1-\zeta^2}+i(0^-)\zeta)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(-B\zeta+i(0^-)\sqrt{1-\zeta^2})\sin(\omega_0\sqrt{1-\zeta^2}t))
\ea\]
\[v_C(0^-)=-\frac{R}{2\zeta}\qty(B\sqrt{1-\zeta^2}+i(0^-)\zeta)\]
\[B=-\qty(2\frac{v_C(0^-)}{R}+i(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\]
\[i=e^{-\omega_0\zeta t}\qty(i(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(2\frac{v_C(0^-)}{R}+i(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[\ba
v_C&=\frac{R}{2\zeta}e^{-\omega_0\zeta t}\qty(\qty(\qty(2\frac{v_C(0^-)}{R}+i(0^-))-i(0^-))\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(\qty(2\frac{v_C(0^-)}{R}+i(0^-))\frac{\zeta^2}{\sqrt{1-\zeta^2}}+i(0^-)\sqrt{1-\zeta^2})\sin(\omega_0\sqrt{1-\zeta^2}t))\\
&=e^{-\omega_0\zeta t}\qty(v_C(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(2\frac{v_C(0^-)}{R}\frac{\zeta^2}{\sqrt{1-\zeta^2}}+i(0^-)\frac{\zeta^2}{\sqrt{1-\zeta^2}}+i(0^-)\frac{1-\zeta^2}{\sqrt{1-\zeta^2}})\frac{R}{2\zeta}\sin(\omega_0\sqrt{1-\zeta^2}t))\\
&=e^{-\omega_0\zeta t}\qty(v_C(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(v_C(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}}+\frac{1}{2}\frac{i(0^-)R}{\zeta\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))
\ea\]
Check $i=C\dv{v_C}{t}$:
\[\ba
C\dv{v_C}{t}&=-\frac{2\zeta^2}{R}e^{-\omega_0\zeta t}\qty(v_C(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(v_C(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}}+\frac{1}{2}\frac{i(0^-)R}{\zeta\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))+\frac{2\zeta\sqrt{1-\zeta^2}}{R}e^{-\omega_0\zeta t}\qty(-v_C(0^-)\sin(\omega_0\sqrt{1-\zeta^2}t)+\qty(v_C(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}}+\frac{1}{2}\frac{i(0^-)R}{\zeta\sqrt{1-\zeta^2}})\cos(\omega_0\sqrt{1-\zeta^2}t))\\
&=\frac{2\zeta}{R}e^{-\omega_0\zeta t}\qty(-v_C(0^-)\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(v_C(0^-)\frac{\zeta^2}{\sqrt{1-\zeta^2}}+i(0^-)R\frac{1}{2\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t)-v_C(0^-)\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}t)+\qty(v_C(0^-)\zeta+i(0^-)R\frac{1}{2\zeta})\cos(\omega_0\sqrt{1-\zeta^2}t))\\
&=\frac{2\zeta}{R}e^{-\omega_0\zeta t}\qty(i(0^-)R\frac{1}{2\zeta}\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(v_C(0^-)\frac{1}{\sqrt{1-\zeta^2}}+i(0^-)R\frac{1}{2\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\\
&=e^{-\omega_0\zeta t}\qty(i(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(2\frac{v_C(0^-)}{R}+i(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))
\ea\]
\[v_R=e^{-\omega_0\zeta t}\qty(i(0^-)R\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(2v_C(0^-)+i(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_L=e^{-\omega_0\zeta t}\qty(-\qty(v_C(0^-)+i(0^-)R)\cos(\omega_0\sqrt{1-\zeta^2}t)+\frac{v_C(0^-)\zeta+\frac{1}{2}i(0^-)R\frac{2\zeta^2-1}{\zeta}}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\end{proof}
\eit
Natural response (Laplace domain):
\[\ba
I&=\frac{i(0^-)LCs-v_C(0^-)C}{LCs^2+RCs+1}\\
&=\frac{i(0^-)s-\frac{2v_C(0^-)\omega_0\zeta}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_R&=\frac{i(0^-)RLCs-v_C(0^-)RC}{LCs^2+RCs+1}\\
&=\frac{i(0^-)Rs-2v_C(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_L&=-\frac{\qty(i(0^-)R+v_C(0^-))LCs+i(0^-)L}{LCs^2+RCs+1}\\
&=-\frac{\qty(i(0^-)R+v_C(0^-))s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=\frac{v_C(0^-)LCs+i(0^-)L+v_C(0^-)RC}{LCs^2+RCs+1}\\
&=\frac{v_C(0^-)s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}+2v_C(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\begin{proof}
\[\ba
I&=\frac{i(0^-)L-\frac{v_C(0^-)}{s}}{Ls+R+\frac{1}{Cs}}\\
&=\frac{i(0^-)LCs-v_C(0^-)C}{LCs^2+RCs+1}\\
&=\frac{i(0^-)s-\frac{v_C(0^-)}{L}}{s^2+\frac{R}{L}s+\frac{1}{LC}}\\
&=\frac{i(0^-)s-\frac{2v_C(0^-)\omega_0\zeta}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_R&=\frac{i(0^-)RLCs-v_C(0^-)RC}{LCs^2+RCs+1}\\
&=\frac{i(0^-)Rs-2v_C(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_L&=LsI-Li(0^-)\\
&=\frac{i(0^-)L^2Cs^2-v_C(0^-)LCs-i(0^-)L^2Cs^2-i(0^-)RLCs-i(0^-)L}{LCs^2+RCs+1}\\
&=-\frac{\qty(i(0^-)R+v_C(0^-))LCs+i(0^-)L}{LCs^2+RCs+1}\\
&=-\frac{\qty(i(0^-)R+v_C(0^-))s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=\frac{I}{Cs}+\frac{v_C(0^-)}{s}\\
&=\frac{i(0^-)Ls-v_C(0^-)+v_C(0^-)\qty(LCs^2+RCs+1)
}{s\qty(LCs^2+RCs+1)}\\
&=\frac{v_C(0^-)LCs+i(0^-)L+v_C(0^-)RC}{LCs^2+RCs+1}\\
&=\frac{\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}s-v_C(0^-)\omega_0^2+v_C(0^-)\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}{s\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{v_C(0^-)s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}+2v_C(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
Check consistency:
\bit
\item $\zeta>1$ Overdamped response:
\[\ba
\mathcal{L}\{i\}&=-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}\frac{1}{s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1})}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}\frac{1}{s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1})}\\
&=\frac{\qty(-i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})-2v_C(0^-)\zeta)\qty(s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1}))+\qty(i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta)\qty(s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1}))}{2R\sqrt{\zeta^2-1}\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{-i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})s-i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})\omega_0\qty(\zeta+\sqrt{\zeta^2-1})-2v_C(0^-)\zeta s-2v_C(0^-)\omega_0\zeta\qty(\zeta+\sqrt{\zeta^2-1})+i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})s+i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})\omega_0\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta s+2v_C(0^-)\omega_0\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{2R\sqrt{\zeta^2-1}\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{2i(0^-)R\sqrt{\zeta^2-1}s-4v_C(0^-)\omega_0\zeta\sqrt{\zeta^2-1}}{2R\sqrt{\zeta^2-1}
\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{i(0^-)s-\frac{2v_C(0^-)\omega_0\zeta}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{v_L\}&=\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}\frac{1}{s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1})}-\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}\frac{1}{s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1})}\\
&=\frac{\qty(i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1}))\qty(s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1}))\qty(i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1}))\qty(s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1}))}{4\zeta\sqrt{\zeta^2-1}\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})^2s+i(0^-)R\omega_0\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})s+2v_C(0^-)\zeta-i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})^2s-i(0^-)R\omega_0\qty(\zeta+\sqrt{\zeta^2-1})-2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})s-2v_C(0^-)\zeta}{4\zeta\sqrt{\zeta^2-1}\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{-4i(0^-)R\zeta\sqrt{\zeta^2-1}s-2i(0^-)R\omega_0\sqrt{\zeta^2-1}-4v_C(0^-)\zeta\sqrt{\zeta^2-1}s}{4\zeta\sqrt{\zeta^2-1}\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=-\frac{\qty(i(0^-)R+v_C(0^-))s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{v_C\}&=\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}\frac{1}{s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1})}-\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}\frac{1}{s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1})}\\
&=\frac{\qty(i(0^-)R+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1}))\qty(s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1}))-\qty(i(0^-)R+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1}))\qty(s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1}))}{4\zeta\sqrt{\zeta^2-1}\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{i(0^-)Rs+i(0^-)R\omega_0\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})s+2v_C(0^-)\omega_0\zeta\qty(\zeta+\sqrt{\zeta^2-1})^2-i(0^-)Rs-i(0^-)R\omega_0\qty(\zeta-\sqrt{\zeta^2-1})-2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})s-2v_C(0^-)\omega_0\zeta\qty(\zeta-\sqrt{\zeta^2-1})^2}{4\zeta\sqrt{\zeta^2-1}\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{2i(0^-)R\omega_0\sqrt{\zeta^2-1}+4v_C(0^-)\zeta\sqrt{\zeta^2-1}s+8v_C(0^-)\omega_0\zeta^2\sqrt{\zeta^2-1}}{4\zeta\sqrt{\zeta^2-1}\qty(s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2})}\\
&=\frac{v_C(0^-)s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}+2v_C(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\item $\zeta=1$ Critically damped response:
\[I=\frac{i(0^-)s-2\frac{v_C(0^-)\omega_0}{R}}{\qty(s+\omega_0)^2}\]
\[V_L=-\frac{\qty(i(0^-)R+v_C(0^-))s+\frac{1}{2}i(0^-)R\omega_0}{\qty(s+\omega_0)^2}\]
\[V_C=\frac{v_C(0^-)s+\frac{1}{2}i(0^-)R\omega_0+2v_C(0^-)\omega_0}{\qty(s+\omega_0)^2}\]
\[\ba
\mathcal{L}\{i\}&=\frac{i(0^-)}{s+\omega_0}-\qty(i(0^-)+2\frac{v_C(0^-)}{R})\omega_0\frac{1}{\qty(s+\omega_0)^2}\\
&=\frac{i(0^-)s-2\frac{v_C(0^-)\omega_0}{R}}{\qty(s+\omega_0)^2}
\ea\]
\[\ba
\mathcal{L}\{v_L\}&=-\frac{i(0^-)R+v_C(0^-)}{s+\omega_0}-\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0\frac{1}{\qty(s+\omega_0)^2}\\
&=-\frac{\qty(i(0^-)R+v_C(0^-))s+\frac{1}{2}i(0^-)R\omega_0}{\qty(s+\omega_0)^2}
\ea\]
\[\ba
\mathcal{L}\{v_C\}&=\frac{v_C(0^-)}{s+\omega_0}+\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0\frac{1}{\qty(s+\omega_0)^2}\\
&=\frac{v_C(0^-)s+\frac{1}{2}i(0^-)R\omega_0+2v_C(0^-)\omega_0}{\qty(s+\omega_0)^2}
\ea\]
\item $0<\zeta<1$ Underdamped response:
\[\ba
\mathcal{L}\{i\}&=i(0^-)\frac{\qty(s+\omega_0\zeta)}{\qty(s+\omega_0\zeta)^2+\omega_0^2\qty(1-\zeta^2)}-\qty(2\frac{v_C(0^-)}{R}+i(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\frac{\omega_0\sqrt{1-\zeta^2}}{\qty(s+\omega_0\zeta)^2+\omega_0^2\qty(1-\zeta^2)}\\
&=\frac{i(0^-)\qty(s+\omega_0\zeta)-\qty(2\frac{v_C(0^-)}{R}+i(0^-))\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^2}\\
&=\frac{i(0^-)s-\frac{2v_C(0^-)\omega_0\zeta}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{v_L\}&=\frac{-\qty(v_C(0^-)+i(0^-)R)\qty(s+\omega_0\zeta)+\frac{v_C(0^-)\zeta+\frac{1}{2}i(0^-)R\frac{2\zeta^2-1}{\zeta}}{\sqrt{1-\zeta^2}}\omega_0\sqrt{1-\zeta^2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=\frac{-\qty(v_C(0^-)+i(0^-)R)s-v_C(0^-)\omega_0\zeta-i(0^-)R\omega_0\zeta+v_C(0^-)\omega_0\zeta+\frac{1}{2}i(0^-)\omega_0R\frac{2\zeta^2-1}{\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=-\frac{\qty(i(0^-)R+v_C(0^-))s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{v_C\}&=\frac{v_C(0^-)\qty(s+\omega_0\zeta)+\qty(v_C(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}}+\frac{1}{2}\frac{i(0^-)R}{\zeta\sqrt{1-\zeta^2}})\omega_0\sqrt{1-\zeta^2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=\frac{v_C(0^-)s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}+2v_C(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\eit
\end{proof}
Forced response (time domain):
\[\dv[2]{i}{t}+\frac{R}{L}\dv{i}{t}+\frac{i}{LC}=\frac{1}{L}\dv{v_{in}}{t}\]
\[\dv[2]{i}{t}+2\omega_0\zeta\dv{i}{t}+\omega_0^{\pht{0}2}=2\frac{\omega_0\zeta}{R}\dv{v_{in}}{t}\]
\begin{proof}
\[v_R+v_C+v_L=v_{in}\]
\[v_R=Ri\]
\[i=C\dv{v_C}{t}\]
\[v_L=L\dv{i}{t}\]
\[R\dv{i}{t}+\frac{i}{C}+L\dv[2]{i}{t}=\dv{v_{in}}{t}\]
\[\dv[2]{i}{t}+\frac{R}{L}\dv{i}{t}+\frac{i}{LC}=\frac{1}{L}\dv{v_{in}}{t}\]
\[\dv[2]{i}{t}+2\omega_0\zeta\dv{i}{t}+\omega_0^{\pht{0}2}=2\frac{\omega_0\zeta}{R}\dv{v_{in}}{t}\]
\end{proof}
\bit
\item $\zeta>1$ Overdamped response:
\[i=2\frac{\omega_0\zeta}{R}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}\]
\[v_R=2\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}\]
\[v_L=v_{in}+\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}\]
\[v_C=\frac{\omega_0}{\sqrt{\zeta^2-1}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))v_{in}(\tau)\dd{\tau}\]
\begin{proof}
\[i_1=e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\]
\[i_2=e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[\frac{1}{i_1i_2'-i_2i_1'}=-\frac{1}{2\omega_0\sqrt{\zeta^2-1}}e^{2\omega_0\zeta t}\]
\[\ba
i&=\frac{\zeta}{R\sqrt{\zeta^2-1}}\qty(e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\int_0^te^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})\tau}\dv{v_{in}}{\tau}e^{2\omega_0\zeta\tau}\dd{\tau}-e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\int_0^te^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})\tau}\dv{v_{in}}{\tau}e^{2\omega_0\zeta\tau}\dd{\tau})\\
&=\frac{\zeta}{R\sqrt{\zeta^2-1}}\qty(e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\int_0^te^{\omega_0\qty(\zeta-\sqrt{\zeta^2-1})\tau}\dv{v_{in}}{\tau}\dd{\tau}-e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\int_0^te^{\omega_0\qty(\zeta+\sqrt{\zeta^2-1})\tau}\dv{v_{in}}{\tau}\dd{\tau})\\
&=\frac{\zeta}{R\sqrt{\zeta^2-1}}\qty(e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\qty(e^{\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}(v_{in}-v_{in}(0^-))-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})\int_0^te^{\omega_0\qty(\zeta-\sqrt{\zeta^2-1})\tau}v_{in}(\tau)\dd{\tau})-e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\qty(e^{\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}(v_{in}-v_{in}(0^-))-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})\int_0^te^{\omega_0\qty(\zeta+\sqrt{\zeta^2-1})\tau}v_{in}(\tau)\dd{\tau}))\\
&=\frac{\omega_0\zeta}{R\sqrt{\zeta^2-1}}\qty(-\qty(\zeta-\sqrt{\zeta^2-1})\int_0^te^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})(t-\tau)}v_{in}(\tau)\dd{\tau}+\qty(\zeta+\sqrt{\zeta^2-1})\int_0^te^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})(t-\tau)}v_{in}(\tau)\dd{\tau})\\
&=\frac{\omega_0\zeta}{R\sqrt{\zeta^2-1}}\int_0^t\qty(-\qty(\zeta-\sqrt{\zeta^2-1})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})(t-\tau)}+\qty(\zeta+\sqrt{\zeta^2-1})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})(t-\tau)})v_{in}(\tau)\dd{\tau}\\
&=\frac{\omega_0\zeta}{R}\int_0^t\qty(-\frac{\zeta}{\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})(t-\tau)}+e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})(t-\tau)}+\frac{\zeta}{\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})(t-\tau)}+e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})(t-\tau)})v_{in}(\tau)\dd{\tau}\\
&=2\frac{\omega_0\zeta}{R}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}
\ea\]
\[v_R=2\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}\]
\[\ba
v_L&=L\dv{i}{t}\\
&=2\frac{L\omega_0\zeta}{R}\qty(v_{in}+\int_0^t\pdv{}{t}\qty(e^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))))v_{in}(\tau)\dd{\tau})\\
&=v_{in}+\int_0^t\qty(
-\omega_0\zeta e^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))
+\omega_0\sqrt{\zeta^2-1}e^{-\omega_0\zeta(t-\tau)}\qty(\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))
)v_{in}(\tau)\dd{\tau}\\
&=v_{in}+\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))+\frac{\zeta^2}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))+\sqrt{\zeta^2-1}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=v_{in}+\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
v_C&=v_{in}-v_R-v_L\\
&=-2\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=\frac{\omega_0}{\sqrt{\zeta^2-1}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))v_{in}(\tau)\dd{\tau}
\ea\]
Check $i=C\dv{v_C}{t}$:
\[\ba
C\dv{v_C}{t}&=\frac{C\omega_0}{\sqrt{\zeta^2-1}}\int_0^t\pdv{}{t}\qty(e^{-\omega_0\zeta(t-\tau)}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=2\frac{\zeta}{R\sqrt{\zeta^2-1}}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\omega_0\sqrt{\zeta^2-1}\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\omega_0\zeta\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=2\frac{\omega_0\zeta}{R}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}
\ea\]
\end{proof}
\item $\zeta=1$ Critically damped response:
\[i=2\frac{\omega_0}{R}\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\]
\[v_R=2\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\]
\[v_L=v_{in}-\omega_0\int_0^t(2-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\]
\[v_C=\omega_0^{\pht{0}2}\int_0^t(t-\tau)e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\]
\begin{proof}
\[i_1=e^{-\omega_0t}\]
\[i_2=te^{-\omega_0t}\]
\[\frac{1}{i_1i_2'-i_2i_1'}=e^{2\omega_0t}\]
\[\ba
i&=2\frac{\omega_0\zeta}{R}\qty(-e^{-\omega_0t}\int_0^t\tau e^{\omega_0\tau}\dv{v_{in}}{\tau}\dd{\tau}+te^{-\omega_0t}\int_0^te^{\omega_0\tau}\dv{v_{in}}{\tau}\dd{\tau})\\
&=2\frac{\omega_0}{R}\qty(-e^{-\omega_0t}\qty(te^{\omega_0t}(v_{in}-v_{in}(0^-))-\int_0^t(\omega_0\tau+1)e^{\omega_0\tau}v_{in}(\tau)\dd{\tau})+te^{-\omega_0t}\qty(e^{\omega_0t}(v_{in}-v_{in}(0^-))-\omega_0\int_0^te^{\omega_0\tau}v_{in}(\tau)\dd{\tau}))\\
&=2\frac{\omega_0}{R}\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}
\ea\]
\[v_R=2\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\]
\[\ba
v_L&=L\dv{i}{t}\\
&=2\frac{L\omega_0}{R}\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\\
&=v_{in}+\int_0^t\pdv{}{t}\qty((1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)})v_{in}(\tau)\dd{\tau}\\
&=v_{in}+\int_0^t-\omega_0e^{-\omega_0(t-\tau)}-(-\omega_0(t-\tau)+1)\omega_0e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\\
&=v_{in}-\omega_0\int_0^t(2-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
v_C&=v_{in}-v_R-v_L\\
&=-2\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}+\omega_0\int_0^t(2-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\\
&=\omega_0^{\pht{0}2}\int_0^t(t-\tau)e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}
\ea\]
Check $i=C\dv{v_C}{t}$:
\[\ba
C\dv{v_C}{t}&=2\frac{\omega_0}{R}\int_0^t\pdv{}{t}\qty((t-\tau)e^{-\omega_0(t-\tau)})v_{in}(\tau)\dd{\tau}\\
&=2\frac{\omega_0}{R}\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}
\ea\]
\end{proof}
\item $0<\zeta<1$ Underdamped response:
\[i=2\frac{\omega_0}{R}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\]
\[v_R=2\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\]
\[v_L=v_{in}+\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\]
\[v_C=\frac{\omega_0}{\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))v_{in}(\tau)\dd{\tau}\]
\begin{proof}
\[i_1=e^{-\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)\]
\[i_2=e^{-\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)\]
\[i_1i_2'=e^{-2\omega_0\zeta t}\qty(-\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\sqrt{1-\zeta^2}\cos^2\qty(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_2i_1'=e^{-2\omega_0\zeta t}\qty(-\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}t)-\omega_0\sqrt{1-\zeta^2}\sin^2\qty(\omega_0\sqrt{1-\zeta^2}t))\]
\[\ba
\frac{1}{i_1i_2'-i_2i_1'}&=\frac{1}{e^{-2\omega_0\zeta t}\qty(-\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\sqrt{1-\zeta^2}\cos^2\qty(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\sqrt{1-\zeta^2}\sin^2\qty(\omega_0\sqrt{1-\zeta^2}t))}\\
&=\frac{1}{\omega_0\sqrt{1-\zeta^2}}e^{2\omega_0\zeta t}
\ea\]
\[\ba
i&=2\frac{\zeta}{R\sqrt{1-\zeta^2}}\qty(-e^{-\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)\int_0^te^{\omega_0\zeta\tau}\sin(\omega_0\sqrt{1-\zeta^2}\tau)\dv{v_{in}}{\tau}\dd{\tau}+e^{-\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)\int_0^te^{\omega_0\zeta\tau}\cos(\omega_0\sqrt{1-\zeta^2}\tau)\dv{v_{in}}{\tau}\dd{\tau})\\
&=2\frac{\zeta}{R\sqrt{1-\zeta^2}}\qty(-e^{-\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)\qty(e^{\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)(v_{in}-v_{in}(0^-))-\int_0^te^{\omega_0\zeta\tau}\qty(\omega_0\sqrt{1-\zeta^2}\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}\tau))v_{in}(\tau)\dd{\tau})+e^{-\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)\qty(e^{\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)(v_{in}-v_{in}(0^-))-\int_0^te^{\omega_0\zeta\tau}\qty(\omega_0\zeta\cos(\omega_0\sqrt{1-\zeta^2}\tau)-\omega_0\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}\tau))v_{in}(\tau)\dd{\tau}))\\
&=2\frac{\zeta}{R\sqrt{1-\zeta^2}}\int_0^t
e^{-\omega_0\zeta(t-\tau)}\qty(\omega_0\sqrt{1-\zeta^2}\cos(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\omega_0\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)\sin(\omega_0\sqrt{1-\zeta^2}\tau)-\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\omega_0\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}t)\sin(\omega_0\sqrt{1-\zeta^2}\tau))v_{in}(\tau)\dd{\tau}\\
&=2\frac{\omega_0\zeta}{R\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\sqrt{1-\zeta^2}\cos(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)\sin(\omega_0\sqrt{1-\zeta^2}\tau)-\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}t)\sin(\omega_0\sqrt{1-\zeta^2}\tau))v_{in}(\tau)\dd{\tau}\\
&=2\frac{\omega_0\zeta}{R\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\sqrt{1-\zeta^2}\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\zeta\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=2\frac{\omega_0}{R}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}
\ea\]
\[v_R=2\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\]
\[\ba
v_L&=L\dv{i}{t}\\
&=v_{in}+\frac{1}{\sqrt{1-\zeta^2}}\int_0^t\pdv{}{t}\qty(e^{-\omega_0\zeta(t-\tau)}\qty(\sqrt{1-\zeta^2}\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\zeta\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))))v_{in}(\tau)\dd{\tau}\\
&=v_{in}+\int_0^t\qty(-\omega_0\zeta e^{-\omega_0\zeta(t-\tau)}\qty(\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))+\omega_0\sqrt{1-\zeta^2}e^{-\omega_0\zeta(t-\tau)}\qty(-\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta}{\sqrt{1-\zeta^2}}\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))))v_{in}(\tau)\dd{\tau}\\
&=v_{in}+\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))+\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=v_{in}+\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
v_C&=v_{in}-v_R-v_L\\
&=-2\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{2\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))-2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=\frac{\omega_0}{\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))v_{in}(\tau)\dd{\tau}
\ea\]
Check $i=C\dv{v_C}{t}$:
\[\ba
C\dv{v_C}{t}&=2\frac{\zeta}{R\sqrt{1-\zeta^2}}\int_0^t\pdv{}{t}\qty(e^{-\omega_0\zeta(t-\tau)}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}\\
&=2\frac{\omega_0}{R}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}
\ea\]
\end{proof}
\eit
Forced response (Laplace domain):
\[\ba
I&=\frac{V_{in}Cs}{LCs^2+RCs+1}\\
&=\frac{2V_{in}\frac{\omega_0\zeta s}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_R&=\frac{V_{in}RCs}{LCs^2+RCs+1}\\
&=\frac{2V_{in}\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_L&=\frac{V_{in}LCs^2}{LCs^2+RCs+1}\\
&=\frac{V_{in}s^2}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=\frac{V_{in}}{LCs^2+RCs+1}\\
&=\frac{V_{in}\omega_0^{\pht{0}2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\begin{proof}
\[\ba
I&=\frac{V_{in}}{Ls+R+\frac{1}{Cs}}\\
&=\frac{V_{in}Cs}{LCs^2+RCs+1}\\
&=\frac{V_{in}\frac{s}{L}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=\frac{2V_{in}\frac{\omega_0\zeta s}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_R&=\frac{V_{in}RCs}{LCs^2+RCs+1}\\
&=\frac{2V_{in}\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_L&=LsI\\
&=\frac{V_{in}LCs^2}{LCs^2+RCs+1}\\
&=\frac{V_{in}s^2}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=\frac{I}{Cs}\\
&=\frac{V_{in}}{LCs^2+RCs+1}\\
&=\frac{V_{in}\omega_0^{\pht{0}2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
Check consistency:
\bit
\item $\zeta>1$ Overdamped response:
\[\ba
\mathcal{L}\{i\}&=2\frac{\omega_0\zeta}{R}\qty(\frac{s+\omega_0\zeta}{\qty(s+\omega_0\zeta)^2-\omega_0^{\pht{0}2}\qty(\zeta^2-1)}-\frac{\zeta}{\sqrt{\zeta^2-1}}\frac{\omega_0\sqrt{\zeta^2-1}}{\qty(s+\omega_0\zeta)^2-\omega_0^{\pht{0}2}\qty(\zeta^2-1)})V_{in}\\
&=\frac{2V_{in}\frac{\omega_0\zeta s}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\item $\zeta=1$ Critically damped response:
\[\ba
\mathcal{L}\{i\}&=2\frac{\omega_0}{R}\qty(\frac{1}{s+\omega_0}-\frac{\omega_0}{\qty(s+\omega_0)^2})V_{in}\\
&=\frac{2V_{in}\frac{\omega_0 s}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\item $0<\zeta<1$ Underdamped response:
\[\ba
\mathcal{L}\{i\}&=2\frac{\omega_0}{R}\qty(\zeta\qty(s+\omega_0\zeta)-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\omega_0\sqrt{1-\zeta^2})\frac{V_{in}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=\frac{2V_{in}\frac{\omega_0\zeta s}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\eit
\end{proof}
Total response (time domain):
\bit
\item $\zeta>1$ Overdamped response:
\[i=2\frac{\omega_0\zeta}{R}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_R=2\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_L=v_{in}+\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))v_{in}(\tau)\dd{\tau}+\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_C=\frac{\omega_0}{\sqrt{\zeta^2-1}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))v_{in}(\tau)\dd{\tau}+\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\item $\zeta=1$ Critically damped response:
\[i=2\frac{\omega_0}{R}\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}\]
\[v_R=2\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}+\qty(i(0^-)-\qty(i(0^-)+2\frac{v_C(0^-)}{R})\omega_0t)e^{-\omega_0t}\]
\[v_L=v_{in}-\omega_0\int_0^t(2-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}-\qty(i(0^-)R+v_C(0^-)+\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\[v_C=\omega_0^{\pht{0}2}\int_0^t(t-\tau)e^{-\omega_0(t-\tau)}v_{in}(\tau)\dd{\tau}+\qty(v_C(0^-)+\qty(\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\item $0<\zeta<1$ Underdamped response:
\[i=2\frac{\omega_0}{R}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}+e^{-\omega_0\zeta t}\qty(i(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(2\frac{v_C(0^-)}{R}+i(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_R=2\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}+e^{-\omega_0\zeta t}\qty(i(0^-)R\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(2v_C(0^-)+i(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_L=v_{in}+\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(-2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))+\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))v_{in}(\tau)\dd{\tau}+e^{-\omega_0\zeta t}\qty(-\qty(v_C(0^-)+i(0^-)R)\cos(\omega_0\sqrt{1-\zeta^2}t)+\frac{v_C(0^-)\zeta+\frac{1}{2}i(0^-)R\frac{2\zeta^2-1}{\zeta}}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_C=\frac{\omega_0}{\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))v_{in}(\tau)\dd{\tau}+e^{-\omega_0\zeta t}\qty(v_C(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(v_C(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}}+\frac{1}{2}\frac{i(0^-)R}{\zeta\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\eit
Total response (Laplace domain):
\[\ba
I&=\frac{V_{in}Cs+i(0^-)LCs-v_C(0^-)C}{LCs^2+RCs+1}\\
&=\frac{2V_{in}\frac{\omega_0\zeta s}{R}+i(0^-)s-\frac{2v_C(0^-)\omega_0\zeta}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_R&=\frac{V_{in}RCs+i(0^-)RLCs-v_C(0^-)RC}{LCs^2+RCs+1}\\
&=\frac{2V_{in}\omega_0\zeta s+i(0^-)Rs-2v_C(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_L&=\frac{V_{in}LCs^2-\qty(i(0^-)R+v_C(0^-))LCs-i(0^-)L}{LCs^2+RCs+1}\\
&=\frac{V_{in}s^2-\qty(i(0^-)R+v_C(0^-))s-\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
V_C&=\frac{V_{in}+v_C(0^-)LCs+i(0^-)L+v_C(0^-)RC}{LCs^2+RCs+1}\\
&=\frac{V_{in}\omega_0^{\pht{0}2}+v_C(0^-)s+\frac{1}{2}\frac{i(0^-)R\omega_0}{\zeta}+2v_C(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
Steady state (time domain):
\[v_C=v_{in}\]
\[v_R=v_L=0\]
\[i=0\]
Constant source forced response (time domain):
\bit
\item $\zeta>1$ Overdamped response:
\[i=2\frac{v_{in}}{R}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)\]
\[v_R=2v_{in}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)\]
\[v_L=v_{in}e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t))\]
\[v_C=v_{in}\qty(1-e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)+\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)))\]
\item $\zeta=1$ Critically damped response:
\[i=2v_{in}\frac{\omega_0}{R}te^{-\omega_0t}\]
\[v_R=2v_{in}\omega_0te^{-\omega_0t}\]
\[v_L=v_{in}\qty(1-\omega_0t)e^{-\omega_0t}\]
\[v_C=v_{in}\qty(1-\qty(1+\omega_0t)e^{-\omega_0t})\]
\item $0<\zeta<1$ Underdamped response:
\[i=2\frac{v_{in}}{R}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t)\]
\[v_R=2v_{in}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t)\]
\[v_L=v_{in}e^{-\omega_0\zeta t}\qty(\cos(\omega_0\sqrt{1-\zeta^2}t)-\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_C=v_{in}\qty(1-e^{-\omega_0\zeta t}\qty(\cos(\omega_0\sqrt{1-\zeta^2}t)+\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t)))\]
\eit
Constant source total response (time domain):
\bit
\item $\zeta>1$ Overdamped response:
\[i=2\frac{v_{in}}{R}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2R\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_R=2v_{in}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)-\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})+2v_C(0^-)\zeta}{2\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_L=v_{in}e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t))+\frac{i(0^-)R\qty(\zeta-\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R\qty(\zeta+\sqrt{\zeta^2-1})^2+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v_C=v_{in}\qty(1-e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)+\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)))+\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta+\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{i(0^-)R+2v_C(0^-)\zeta\qty(\zeta-\sqrt{\zeta^2-1})}{4\zeta\sqrt{\zeta^2-1}}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\item $\zeta=1$ Critically damped response:
\[i=\qty(i(0^-)+\qty(-i(0^-)+2\frac{v_{in}-v_C(0^-)}{R})\omega_0t)e^{-\omega_0t}\]
\[v_R=\qty(i(0^-)R+\qty(-Ri(0^-)+2\qty(v_{in}-v_C(0^-)))\omega_0t)e^{-\omega_0t}\]
\[v_L=\qty(v_{in}-i(0^-)R-v_C(0^-)-\qty(v_{in}+\frac{1}{2}i(0^-)R+v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\[v_C=v_{in}-\qty(v_{in}-v_C(0^-)+\qty(v_{in}-\frac{1}{2}i(0^-)R-v_C(0^-))\omega_0t)e^{-\omega_0t}\]
\item $0<\zeta<1$ Underdamped response:
\[i=e^{-\omega_0\zeta t}\qty(i(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(2\frac{v_{in}-v_C(0^-)}{R}-i(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_R=e^{-\omega_0\zeta t}\qty(i(0^-)R\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(2\qty(v_{in}-v_C(0^-))-i(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_L=e^{-\omega_0\zeta t}\qty(\qty(v_{in}-v_C(0^-)-i(0^-)R)\cos(\omega_0\sqrt{1-\zeta^2}t)-\frac{v_{in}-v_C(0^-)\zeta-\frac{1}{2}i(0^-)R\frac{2\zeta^2-1}{\zeta}}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_C=v_{in}-e^{-\omega_0\zeta t}\qty(\qty(v_{in}-v_C(0^-))\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(\qty(v_{in}-v_C(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}-\frac{1}{2}\frac{i(0^-)R}{\zeta\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\eit
Resonance state (time domain): Maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[v_{in}=v_m\cos(\omega_0t+\theta)\]
\[i(0^-)=\frac{v_m}{R}\]
\[v_C(0^-)=0\]
\[i=\frac{v_m}{R}\cos(\omega_0t+\theta)\]
\[v_C=-v_L=\frac{v_m}{RC\omega_0}\sin(\omega_0t+\theta)=\frac{v_mL\omega_0}{R}\sin(\omega_0t+\theta)\]
\[E_m=\frac{Lv_m^{\pht{m}2}}{2R^2}\]
\[E_l=\frac{v_m^{\pht{m}2}\pi}{R\omega_0}\]
\[Q=\frac{L\omega_0}{R}=\frac{1}{R}\sqrt{\frac{L}{C}}\]
Resonance state (phasor domain):
\[\mb{V}_{in}=v_me^{j\theta}\]
\[\mb{I}=\frac{v_m}{R}e^{j\theta}\]
\[\mb{V}_C=-\mb{V}_L=-\frac{jv_m}{RC\omega_0}e^{j\theta}=-\frac{jv_mL\omega_0}{R}e^{j\theta}\]
Impulse response:
\bit
\item $\zeta>1$ Overdamped response:
\[h_i=2\frac{\omega_0\zeta}{R}e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t))\]
\[h_{v_R}=2\omega_0\zeta e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t))\]
\[h_{v_L}=v_{in}+\omega_0e^{-\omega_0\zeta t}\qty(-2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}t)+\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t))\]
\[h_{v_C}=\frac{\omega_0}{\sqrt{\zeta^2-1}}e^{-\omega_0\zeta t}\sinh(\omega_0\sqrt{\zeta^2-1}t)\]
\item $\zeta=1$ Critically damped response:
\[h_i=2\frac{\omega_0}{R}(1-\omega_0t)e^{-\omega_0t}\]
\[h_{v_R}=2\omega_0(1-\omega_0t)e^{-\omega_0t}\]
\[h_{v_L}=v_{in}-\omega_0(2-\omega_0t)e^{-\omega_0t}\]
\[h_{v_C}=\omega_0^{\pht{0}2}te^{-\omega_0t}\]
\item $0<\zeta<1$ Underdamped response:
\[h_i=2\frac{\omega_0}{R}e^{-\omega_0\zeta t}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[h_{v_R}=2\omega_0e^{-\omega_0\zeta t}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[h_{v_L}=v_{in}+\omega_0e^{-\omega_0\zeta t}\qty(-2\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)+\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[h_{v_C}=\frac{\omega_0}{\sqrt{1-\zeta^2}}e^{-\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)\]
\eit
Transfer function:
\[\ba
H_I&=\frac{Cs}{LCs^2+RCs+1}\\
&=\frac{2\frac{\omega_0\zeta s}{R}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{V_R}&=\frac{RCs}{LCs^2+RCs+1}\\
&=\frac{2\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{V_L}&=\frac{LCs^2}{LCs^2+RCs+1}\\
&=\frac{s^2}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{V_C}&=\frac{1}{LCs^2+RCs+1}\\
&=\frac{\omega_0^{\pht{0}2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
$V_L$ being high-pass filter:
\[\lim_{\omega\to 0}\abs{H_{V_L}(j\omega)}=0\]
\[\lim_{\omega\to\infty}\abs{H_{V_L}(j\omega)}=1\]
$V_C$ being low-pass filter:
\[\lim_{\omega\to 0}\abs{H_{V_C}(j\omega)}=1\]
\[\lim_{\omega\to\infty}\abs{H_{V_C}(j\omega)}=0\]
\sssc{Parallel RLC circuit}
A parallel RLC (oscillator) circuit consists of a resistor with resistance $R$, an inductor with inductance $L$, a capacitor with capacitance $C$, and an independent current source $i_{in}$ in parallel connection. Neper frequency or attenuation $\alpha$, angular resonance/resonant frequency $\omega_0$, damping factor/ratio $\zeta$, characteristic roots $r_{1,2}$, critical resistance $R_c$ (the resistance for critically damped response), damping angular frequency $\omega_d$, $t_n=\frac{2\pi n}{\omega}$, stored energy in the inductor and capacitor $E_L$ and $E_C$, $E=E_L+E_C$, dissipated energy of the resistor in $E_R$.

Natural response (time domain):
\[\dv[2]{v}{t}+\frac{1}{RC}\dv{v}{t}+\frac{v}{LC}=0\]
\[\alpha=\frac{1}{2RC}\]
\[\omega_0=\frac{1}{\sqrt{LC}}\]
\[\zeta=\frac{1}{2R}\sqrt{\frac{L}{C}}\]
\[R_c=\frac{1}{2}\sqrt{\frac{L}{C}}\]
\[\omega_d=\omega_0\sqrt{1-\zeta^2}\]
\[\dv[2]{v}{t}+2\omega_0\zeta\dv{v}{t}+\omega_0^{\pht{0}2}v=0\]
\[r_{1,2}=-\omega_0\qty(\zeta\pm\sqrt{\zeta^2-1})\]
\begin{proof}
\[i_R+i_L+i_C=0\]
\[v=Ri_R\]
\[i_C=C\dv{v}{t}\]
\[v=L\dv{i_L}{t}\]
\[\frac{1}{R}\dv{v}{t}+\frac{v}{L}+C\dv[2]{v}{t}=0\]
\[\dv[2]{v}{t}+\frac{1}{RC}\dv{v}{t}+\frac{v}{LC}=0\]
\[\alpha=\frac{1}{2RC}\]
\[\omega_0=\frac{1}{\sqrt{LC}}\]
\[\zeta=\frac{\alpha}{\omega_0}=\frac{1}{2R}\sqrt{\frac{L}{C}}\]
\[\dv[2]{v}{t}+2\omega_0\zeta\dv{v}{t}+\omega_0^{\pht{0}2}v=0\]
\[r^2+2\omega_0\zeta r+\omega_0^{\pht{0}2}=0\]
\[\ba
r_{1,2}&=\frac{-2\omega_0\zeta\pm\sqrt{4\omega_0^{\pht{0}2}\zeta^2-4\omega_0^{\pht{0}2}}}{2}\\
&=-\omega_0\qty(\zeta\pm\sqrt{\zeta^2-1})
\ea\]
\end{proof}
\bit
\item $\zeta>1$ Overdamped response:
\[v=-\qty(v(0^-)\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(v(0^-)\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_R=-\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_L=\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_C=\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\begin{proof}
\[v=Ae^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+Be^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[v(0^-)=A+B\]
\[i_R=\frac{A}{R}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\frac{B}{R}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[\ba
i_C&=C\dv{v}{t}\\
&=-\frac{A}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{B}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}
\ea\]
\[\ba
i_L&=-i_R-i_C\\
&=-\frac{A}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\frac{B}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}
\ea\]
\[\ba
i_L(0^-)&=-\frac{A}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}-\frac{v(0^-)-A}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}\\
&=-\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}-\frac{A}{R}\frac{\sqrt{\zeta^2-1}}{\zeta}
\ea\]
\[A=-\qty(v(0^-)\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})\]
\[B=v(0^-)\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}}\]
\[v=-\qty(v(0^-)\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(v(0^-)\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_L=\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
Check $v=L\dv{i_L}{t}$:
\[\ba
L\dv{i_L}{t}&=-\qty(v(0^-)\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(v(0^-)\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}
\ea\]
\[i_R=-\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_C=\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\end{proof}
\item $\zeta=1$ Critically damped response:
\[v=(v(0^-)-(v(0^-)+2i_L(0^-)R)\omega_0t)e^{-\omega_0t}\]
\[i_R=\qty(\frac{v(0^-)}{R}-\qty(\frac{v(0^-)}{R}+2i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\[i_L=\qty(i_L(0^-)+(\frac{1}{2}\frac{v(0^-)}{R}+i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\[i_C=\qty(-\frac{v(0^-)}{R}-i_L(0^-)+\qty(\frac{1}{2}\frac{v(0^-)}{R}+i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\begin{proof}
\[v=(A+Bt)e^{-\omega_0t}\]
\[A=v(0^-)\]
\[v=(v(0^-)+Bt)e^{-\omega_0t}\]
\[i_R=\frac{v(0^-)+Bt}{R}e^{-\omega_0t}\]
\[\ba
i_C&=C\dv{v}{t}\\
&=\frac{\frac{B}{\omega_0}-v(0^-)-Bt}{2R}e^{-\omega_0t}
\ea\]
\[\ba
i_L&=-i_R-i_C\\
&=-\frac{\frac{B}{\omega_0}+v(0^-)+Bt}{2R}e^{-\omega_0t}
\ea\]
\[i_L(0^-)=-\frac{\frac{B}{\omega_0}+v(0^-)}{2R}\]
\[B=-(v(0^-)+2i_L(0^-)R)\omega_0\]
\[v=(v(0^-)-(v(0^-)+2i_L(0^-)R)\omega_0t)e^{-\omega_0t}\]
\[i_L=\qty(i_L(0^-)+(\frac{1}{2}\frac{v(0^-)}{R}+i_L(0^-))\omega_0t)e^{-\omega_0t}\]
Check $v=L\dv{i_L}{t}$:
\[L\dv{i_L}{t}=(v(0^-)-(v(0^-)+2i_L(0^-)R)\omega_0t)e^{-\omega_0t}\]
\[i_R=\qty(\frac{v(0^-)}{R}-\qty(\frac{v(0^-)}{R}+2i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\[i_C=\qty(-\frac{v(0^-)}{R}-i_L(0^-)+\qty(\frac{1}{2}\frac{v(0^-)}{R}+i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\end{proof}
\item $0<\zeta<1$ Underdamped response:
\[v=e^{-\omega_0\zeta t}\qty(v(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(v(0^-)+2i_L(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_R=e^{-\omega_0\zeta t}\qty(\frac{v(0^-)}{R}\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(\frac{v(0^-)}{R}+2i_L(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_L=e^{-\omega_0\zeta t}\qty(i_L(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(\frac{1}{2}\frac{v(0^-)}{R\zeta\sqrt{1-\zeta^2}}+i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_C=e^{-\omega_0\zeta t}\qty(\qty(\frac{v(0^-)}{R}+i_L(0^-))\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(\frac{1}{2}\frac{v(0^-)}{R}\frac{1-2\zeta^2}{\zeta\sqrt{1-\zeta^2}}-i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[\omega=\omega_0\sqrt{1-\zeta^2}\]
\[t_n=\frac{2\pi n}{\omega_0\sqrt{1-\zeta^2}}\]
\[v(t_n)=e^{-\omega_0\zeta t_n}v(0^-)\]
\[i_L(t_n)=e^{-\omega_0\zeta t}i_L(0^-)\]
\[E_C(t_n)=\frac{1}{2}C\qty(v(0^-))^2e^{-2\omega_0\zeta t_n}\]
\[E_L(t_n)=\frac{1}{2}L\qty(i_L(0^-))^2e^{-2\omega_0\zeta t_n}\]
\[E(t_n)=\qty(\frac{1}{2}L\qty(i_L(0^-))^2+\frac{1}{2}C\qty(v(0^-))^2)e^{-2\omega_0\zeta t_n}\]
\[E_R(t_n)=\qty(\frac{1}{2}L\qty(i_L(0^-))^2+\frac{1}{2}C\qty(v(0^-))^2)\qty(1-e^{-2\omega_0\zeta t_n})\]
\begin{proof}
\[v=e^{-\omega_0\zeta t}\qty(A\cos(\omega_0\sqrt{1-\zeta^2}t)+B\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[A=i(0^-)\]
\[v=e^{-\omega_0\zeta t}\qty(v(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+B\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_R=\frac{1}{R}e^{-\omega_0\zeta t}\qty(v(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+B\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[\ba
i_C&=C\dv{v}{t}\\
&=\frac{1}{2R\omega_0\zeta}e^{-\omega_0\zeta t}\qty(-\omega_0\zeta v(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\omega_0\zeta B\sin(\omega_0\sqrt{1-\zeta^2}t)-\omega_0\sqrt{1-\zeta^2}v(0^-)\sin(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\sqrt{1-\zeta^2}B\cos(\omega_0\sqrt{1-\zeta^2}t))\\
&=-\frac{1}{2R}e^{-\omega_0\zeta t}\qty(\qty(v(0^-)-B\frac{\sqrt{1-\zeta^2}}{\zeta})\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(v(0^-)\frac{\sqrt{1-\zeta^2}}{\zeta}+B)\sin(\omega_0\sqrt{1-\zeta^2}t))
\ea\]
\[\ba
i_L&=-i_R-i_C\\
&=\frac{1}{2R}e^{-\omega_0\zeta t}\qty(-\qty(v(0^-)+B\frac{\sqrt{1-\zeta^2}}{\zeta})\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(v(0^-)\frac{\sqrt{1-\zeta^2}}{\zeta}-B)\sin(\omega_0\sqrt{1-\zeta^2}t))
\ea\]
\[i_L(0^-)=-\frac{1}{2R}\qty(v(0^-)+B\frac{\sqrt{1-\zeta^2}}{\zeta})\]
\[B=-\qty(v(0^-)+2i_L(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\]
\[v=e^{-\omega_0\zeta t}\qty(v(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(v(0^-)+2i_L(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_L=e^{-\omega_0\zeta t}\qty(i_L(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(\frac{1}{2}\frac{v(0^-)}{R\zeta\sqrt{1-\zeta^2}}+i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
Check $v=L\dv{i_L}{t}$:
\[\ba
L\dv{i_L}{t}&=2R\zeta e^{-\omega_0\zeta t}\qty(-i_L(0^-)\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(\frac{1}{2}\frac{v(0^-)}{R\sqrt{1-\zeta^2}}+i_L(0^-)\frac{\zeta^2}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t)-i_L(0^-)\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}t)+\qty(\frac{1}{2}\frac{v(0^-)}{R\zeta}+i_L(0^-)\zeta)\cos(\omega_0\sqrt{1-\zeta^2}t))\\
&=e^{-\omega_0\zeta t}\qty(v(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(v(0^-)+2i_L(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))
\ea\]
\[i_R=e^{-\omega_0\zeta t}\qty(\frac{v(0^-)}{R}\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(\frac{v(0^-)}{R}+2i_L(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_C=e^{-\omega_0\zeta t}\qty(\qty(\frac{v(0^-)}{R}+i_L(0^-))\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(\frac{1}{2}\frac{v(0^-)}{R}\frac{1-2\zeta^2}{\zeta\sqrt{1-\zeta^2}}-i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\end{proof}
\eit
Natural response (Laplace domain):
\[\ba
V&=\frac{v(0^-)RLCs-i_L(0^-)RL}{RLCs^2+Ls+R}\\
&=\frac{v(0^-)s-2i_L(0^-)R\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_R&=\frac{v(0^-)LCs-i_L(0^-)L}{RLCs^2+Ls+R}\\
&=\frac{\frac{v(0^-)s}{R}-2i_L(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=\frac{i_L(0^-)RLCs+v(0^-)RC+i_L(0^-)L}{RLCs^2+Ls+R}\\
&=\frac{i_L(0^-)s+\frac{v(0^-)\omega_0}{2R\zeta}+2i_L(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_C&=-\frac{\qty(v(0^-)+i_L(0^-)R)LCs+v(0^-)RC}{RLCs^2+Ls+R}\\
&=-\frac{\qty(\frac{v(0^-)}{R}+i_L(0^-))s+\frac{v(0^-)\omega_0}{2R\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\begin{proof}
\[\ba
V&=\frac{v(0^-)C-\frac{i_L(0^-)}{s}}{Cs+\frac{1}{R}+\frac{1}{Ls}}\\
&=\frac{v(0^-)RLCs-i_L(0^-)RL}{RLCs^2+Ls+R}\\
&=\frac{v(0^-)s-2i_L(0^-)R\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_R&=\frac{v(0^-)LCs-i_L(0^-)L}{RLCs^2+Ls+R}\\
&=\frac{\frac{v(0^-)s}{R}-2i_L(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=\frac{V}{Ls}+\frac{i_L(0^-)}{s}\\
&=\frac{v(0^-)RC-\frac{i_L(0^-)R}{s}+i_L(0^-)RLCs+i_L(0^-)L+\frac{i_L(0^-)R}{s}}{RLCs^2+Ls+R}\\
&=\frac{i_L(0^-)RLCs+v(0^-)RC+i_L(0^-)L}{RLCs^2+Ls+R}\\
&=\frac{i_L(0^-)s+\frac{v(0^-)\omega_0}{2R\zeta}+2i_L(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_C&=CsV-Cv(0^-)\\
&=\frac{v(0^-)RLC^2s^2-i_L(0^-)RLCs-v(0^-)RLC^2s^2-v(0^-)LCs-v(0^-)RC}{RLCs^2+Ls+R}\\
&=-\frac{\qty(v(0^-)+i_L(0^-)R)LCs+v(0^-)RC}{RLCs^2+Ls+R}\\
&=-\frac{\qty(\frac{v(0^-)}{R}+i_L(0^-))s+\frac{v(0^-)\omega_0}{2R\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
Check consistency:
\bit
\item $\zeta>1$ Overdamped response:
\[\ba
\mathcal{L}\{v\}&=-\qty(v(0^-)\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{1}{s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1})}+\qty(v(0^-)\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{1}{s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1})}\\
&=\frac{-\qty(v(0^-)\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})\qty(s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1}))+\qty(v(0^-)\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})\qty(s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1}))}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=\frac{v(0^-)s-2i_L(0^-)R\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{i_L\}&=\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}\frac{1}{s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1})}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}\frac{1}{s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1})}\\
&=\frac{\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}\qty(s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1}))-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}\qty(s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1}))}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=\frac{i_L(0^-)s+\frac{v(0^-)\omega_0}{2R\zeta}+2i_L(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{i_C\}&=\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}\frac{1}{s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1})}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}\frac{1}{s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1})}\\
&=\frac{\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}\qty(s+\omega_0\qty(\zeta+\sqrt{\zeta^2-1}))-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}\qty(s+\omega_0\qty(\zeta-\sqrt{\zeta^2-1}))}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=-\frac{\qty(\frac{v(0^-)}{R}+i_L(0^-))s+\frac{v(0^-)\omega_0}{2R\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\item $\zeta=1$ Critically damped response:
\[\ba
\mathcal{L}\{v\}&=\frac{v(0^-)}{s+\omega_0}-\frac{(v(0^-)+2i_L(0^-)R)\omega_0}{s^2+2\omega_0s+\omega_0^{\pht{0}2}}\\
&=\frac{v(0^-)s-2i_L(0^-)R\omega_0}{s^2+2\omega_0s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{i_L\}&=\frac{i_L(0^-)}{s+\omega_0}+\frac{(\frac{1}{2}\frac{v(0^-)}{R}+i_L(0^-))\omega_0}{s^2+2\omega_0s+\omega_0^{\pht{0}2}}\\
&=\frac{i_L(0^-)s+\frac{v(0^-)\omega_0}{2R}+2i_L(0^-)\omega_0}{s^2+2\omega_0s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{i_C\}&=-\frac{\frac{v(0^-)}{R}+i_L(0^-)}{s+\omega_0}+\frac{\qty(\frac{1}{2}\frac{v(0^-)}{R}+i_L(0^-))\omega_0}{s^2+2\omega_0s+\omega_0^{\pht{0}2}}\\
&=-\frac{\qty(\frac{v(0^-)}{R}+i_L(0^-))s+\frac{v(0^-)\omega_0}{2R}}{s^2+2\omega_0s+\omega_0^{\pht{0}2}}
\ea\]
\item $0<\zeta<1$ Underdamped response:
\[\ba
\mathcal{L}\{v\}&=\frac{v(0^-)\qty(s+\omega\zeta)-\qty(v(0^-)+2i_L(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\omega_0\sqrt{1-\zeta^2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=\frac{v(0^-)s-2i_L(0^-)R\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{i_L\}&=\frac{i_L(0^-)\qty(s+\omega\zeta)+\qty(\frac{1}{2}\frac{v(0^-)}{R\zeta\sqrt{1-\zeta^2}}+i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\omega_0\sqrt{1-\zeta^2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=\frac{i_L(0^-)s+\frac{v(0^-)\omega_0}{2R\zeta}+2i_L(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
\mathcal{L}\{i_C\}&=\frac{\qty(\frac{v(0^-)}{R}+i_L(0^-))\qty(s+\omega\zeta)+\qty(\frac{1}{2}\frac{v(0^-)}{R}\frac{1-2\zeta^2}{\zeta\sqrt{1-\zeta^2}}-i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\omega_0\sqrt{1-\zeta^2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
&=-\frac{\qty(\frac{v(0^-)}{R}+i_L(0^-))s+\frac{v(0^-)\omega_0}{2R\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\eit
\end{proof}
Forced response (time domain):
\[\dv[2]{v}{t}+\frac{1}{RC}\dv{v}{t}+\frac{v}{LC}=\frac{1}{C}\dv{i_{in}}{t}\]
\[\dv[2]{v}{t}+2\omega_0\zeta\dv{v}{t}+\omega_0^{\pht{0}2}v=2R\omega_0\zeta\dv{i_{in}}{t}\]
\begin{proof}
\[i_R+i_L+i_C=i_{in}\]
\[v=Ri_R\]
\[i_C=C\dv{v}{t}\]
\[v=L\dv{i_L}{t}\]
\[\frac{1}{R}\dv{v}{t}+\frac{v}{L}+C\dv[2]{v}{t}=\dv{i_{in}}{t}\]
\[\dv[2]{v}{t}+\frac{1}{RC}\dv{v}{t}+\frac{v}{LC}=\frac{1}{C}\dv{i_{in}}{t}\]
\[\dv[2]{v}{t}+2\omega_0\zeta\dv{v}{t}+\omega_0^{\pht{0}2}v=2R\omega_0\zeta\dv{i_{in}}{t}\]
\end{proof}
\bit
\item $\zeta>1$ Overdamped response:
\[v=2R\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\[i_R=2\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\[i_L=\frac{\omega_0}{\sqrt{\zeta^2-1}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))i_{in}(\tau)\dd{\tau}\]
\[i_C=i_{in}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\bpr
\[v_1=e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\]
\[v_2=e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[\frac{1}{v_1v_2'-v_2v_1'}=-\frac{1}{2\omega_0\sqrt{\zeta^2-1}}e^{2\omega_0\zeta t}\]
\[\ba
v&=\frac{R\zeta}{\sqrt{\zeta^2-1}}\qty(e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\int_0^te^{\omega_0\qty(\zeta-\sqrt{\zeta^2-1})\tau}\dv{i_{in}}{\tau}\dd{\tau}-e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\int_0^te^{\omega_0\qty(\zeta+\sqrt{\zeta^2-1})\tau}\dv{i_{in}}{\tau}\dd{\tau})\\
&=\frac{R\zeta}{\sqrt{\zeta^2-1}}\qty(e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\qty(e^{\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}(i_{in}-i_{in}(0^-))-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})\int_0^te^{\omega_0\qty(\zeta-\sqrt{\zeta^2-1})\tau}i_{in}(\tau)\dd{\tau})-e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\qty(e^{\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}(i_{in}-i_{in}(0^-))-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})\int_0^te^{\omega_0\qty(\zeta+\sqrt{\zeta^2-1})\tau}i_{in}(\tau)\dd{\tau}))\\
&=\frac{R\omega_0\zeta}{\sqrt{\zeta^2-1}}\qty(-e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\qty(\zeta-\sqrt{\zeta^2-1})\int_0^te^{\omega_0\qty(\zeta-\sqrt{\zeta^2-1})\tau}i_{in}(\tau)\dd{\tau}+e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}\qty(\zeta+\sqrt{\zeta^2-1})\int_0^te^{\omega_0\qty(\zeta+\sqrt{\zeta^2-1})\tau}i_{in}(\tau)\dd{\tau})\\
&=\frac{R\omega_0\zeta}{\sqrt{\zeta^2-1}}\int_0^t\qty(-\qty(\zeta-\sqrt{\zeta^2-1})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})(t-\tau)}+\qty(\zeta+\sqrt{\zeta^2-1})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})(t-\tau)})i_{in}(\tau)\dd{\tau}\\
&=\frac{R\omega_0\zeta}{\sqrt{\zeta^2-1}}\int_0^t\qty(-\zeta e^{-\omega_0\zeta(t-\tau)}\qty(e^{\omega_0\sqrt{\zeta^2-1}(t-\tau)}-e^{-\omega_0\sqrt{\zeta^2-1}(t-\tau)})+\sqrt{\zeta^2-1}e^{-\omega_0\zeta(t-\tau)}\qty(e^{\omega_0\sqrt{\zeta^2-1}(t-\tau)}+e^{-\omega_0\sqrt{\zeta^2-1}(t-\tau)}))i_{in}(\tau)\dd{\tau}\\
&=2R\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}
\ea\]
\[i_R=2\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\[\ba
i_C&=C\dv{v}{t}\\
&=i_{in}+\int_0^t\pdv{}{t}\qty(e^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))))i_{in}(\tau)\dd{\tau}\\
&=i_{in}+\omega_0\int_0^t\qty(-\zeta e^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))+\sqrt{\zeta^2-1}e^{-\omega_0\zeta(t-\tau)}\qty(\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))))i_{in}(\tau)\dd{\tau}\\
&=i_{in}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
i_L&=i_{in}-i_R-i_C\\
&=\frac{\omega_0}{\sqrt{\zeta^2-1}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))i_{in}(\tau)\dd{\tau}
\ea\]
Check $v=L\dv{i_L}{t}$:
\[L\dv{i_L}{t}=2R\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\epr
\item $\zeta=1$ Critically damped response:
\[v=2R\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}\]
\[i_R=2\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}\]
\[i_L=\omega_0^{\pht{0}2}\int_0^t(t-\tau)e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}\]
\[i_C=i_{in}-\omega_0\int_0^t\qty(2-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}\]
\bpr
\[v_1=e^{-\omega_0t}\]
\[v_2=te^{-\omega_0t}\]
\[\frac{1}{v_1v_2'-v_2v_1'}=e^{2\omega_0t}\]
\[\ba
v&=2R\omega_0\qty(-e^{-\omega_0t}\int_0^t te^{\omega_0\tau}\dv{i_{in}}{\tau}\dd{\tau}+te^{-\omega_0t}\int_0^t e^{\omega_0\tau}\dv{i_{in}}{\tau}\dd{\tau})\\
&=2R\omega_0\qty(-e^{-\omega_0t}\qty(te^{\omega_0t}(i_{in}-i_{in}(0^-))-\int_0^t(1+\omega_0\tau)e^{\omega_0\tau}i_{in}(\tau)\dd{\tau})+te^{-\omega_0t}\qty(e^{\omega_0t}(i_{in}-i_{in}(0^-))-\int_0^t\omega_0e^{\omega_0\tau}i_{in}(\tau)\dd{\tau}))\\
&=2R\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}
\ea\]
\[i_R=2\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}\]
\[\ba
i_C&=C\dv{v}{t}\\
&=i_{in}+\int_0^t\pdv{}{t}\qty((1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)})i_{in}(\tau)\dd{\tau}\\
&=i_{in}-\omega_0\int_0^t\qty(2-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
i_L&=i_{in}-i_R-i_C\\
&=\omega_0^{\pht{0}2}\int_0^t(t-\tau)e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}
\ea\]
Check $v=L\dv{i_L}{t}$:
\[L\dv{i_L}{t}=2R\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}\]
\epr
\item $0<\zeta<1$ Underdamped response:
\[v=2R\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\[i_R=2\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\[i_L=\frac{\omega_0}{\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))i_{in}(\tau)\dd{\tau}\]
\[i_C=i_{in}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\bpr
\[v_1=e^{-\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)\]
\[v_2=e^{-\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)\]
\[v_1v_2'=e^{-2\omega_0\zeta t}\qty(-\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\sqrt{1-\zeta^2}\cos^2\qty(\omega_0\sqrt{1-\zeta^2}t))\]
\[v_2v_1'=e^{-2\omega_0\zeta t}\qty(-\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}t)-\omega_0\sqrt{1-\zeta^2}\sin^2\qty(\omega_0\sqrt{1-\zeta^2}t))\]
\[\ba
\frac{1}{v_1v_2'-v_2v_1'}&=\frac{1}{e^{-2\omega_0\zeta t}\qty(-\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\sqrt{1-\zeta^2}\cos^2\qty(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}t)+\omega_0\sqrt{1-\zeta^2}\sin^2\qty(\omega_0\sqrt{1-\zeta^2}t))}\\
&=\frac{1}{\omega_0\sqrt{1-\zeta^2}}e^{2\omega_0\zeta t}
\ea\]
\[\ba
v&=\frac{2R\zeta}{\sqrt{1-\zeta^2}}\qty(-e^{-\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)\int_0^te^{\omega_0\zeta\tau}\sin(\omega_0\sqrt{1-\zeta^2}\tau)\dv{i_{in}}{\tau}\dd{\tau}+e^{-\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)\int_0^te^{\omega_0\zeta\tau}\cos(\omega_0\sqrt{1-\zeta^2}\tau)\dv{i_{in}}{\tau}\dd{\tau})\\
&=\frac{2R\zeta}{\sqrt{1-\zeta^2}}\qty(-e^{-\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)\qty(e^{\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)(i_{in}-i_{in}(0^-))-\omega_0\int_0^te^{\omega_0\zeta\tau}\qty(\sqrt{1-\zeta^2}\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\zeta\sin(\omega_0\sqrt{1-\zeta^2}\tau))i_{in}(\tau)\dd{\tau})+e^{-\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)\qty(e^{\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)(i_{in}-i_{in}(0^-))-\omega_0\int_0^te^{\omega_0\zeta\tau}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}\tau)-\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}\tau))i_{in}(\tau)\dd{\tau}))\\
&=\frac{2R\omega_0\zeta}{\sqrt{1-\zeta^2}}\qty(e^{-\omega_0\zeta t}\cos(\omega_0\sqrt{1-\zeta^2}t)\int_0^te^{\omega_0\zeta\tau}\qty(\sqrt{1-\zeta^2}\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\zeta\sin(\omega_0\sqrt{1-\zeta^2}\tau))i_{in}(\tau)\dd{\tau}-e^{-\omega_0\zeta t}\sin(\omega_0\sqrt{1-\zeta^2}t)\int_0^te^{\omega_0\zeta\tau}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}\tau)-\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}\tau))i_{in}(\tau)\dd{\tau})\\
&=\frac{2R\omega_0\zeta}{\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\sqrt{1-\zeta^2}\cos(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\zeta\cos(\omega_0\sqrt{1-\zeta^2}t)\sin(\omega_0\sqrt{1-\zeta^2}\tau)-\zeta\sin(\omega_0\sqrt{1-\zeta^2}t)\cos(\omega_0\sqrt{1-\zeta^2}\tau)+\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}t)\sin(\omega_0\sqrt{1-\zeta^2}\tau))i_{in}(\tau)\dd{\tau}\\
&=2R\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}
\ea\]
\[i_R=2\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\[\ba
i_C&=C\dv{v}{t}\\
&=i_{in}+\int_0^t\pdv{}{t}\qty(e^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))))i_{in}(\tau)\dd{\tau}\\
&=i_{in}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))+\sqrt{1-\zeta^2}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))+\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}\\
&=i_{in}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}
\ea\]
\[\ba
i_L&=i_{in}-i_R-i_C\\
&=\frac{\omega_0}{\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))i_{in}(\tau)\dd{\tau}
\ea\]
Check $v=L\dv{i_L}{t}$:
\[L\dv{i_L}{t}=2R\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}\]
\epr
\eit
Forced response (Laplace domain):
\[\ba
V&=\frac{I_{in}RLs}{RLCs^2+Ls+R}\\
&=\frac{2I_{in}R\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_R&=\frac{I_{in}Ls}{RLCs^2+Ls+R}\\
&=\frac{2I_{in}\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=\frac{I_{in}R}{RLCs^2+Ls+R}\\
&=\frac{I_{in}\omega_0^{\pht{0}2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
\ea\]
\[\ba
I_C&=\frac{I_{in}RLCs^2}{RLCs^2+Ls+R}\\
&=\frac{I_{in}s^2}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\bpr
\[\ba
V&=\frac{I_{in}}{Cs+\frac{1}{R}+\frac{1}{Ls}}\\
&=\frac{I_{in}RLs}{RLCs^2+Ls+R}\\
&=\frac{I_{in}\frac{s}{C}}{s^2+\frac{s}{RC}+\frac{1}{LC}}\\
&=\frac{2I_{in}R\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_R&=\frac{I_{in}Ls}{RLCs^2+Ls+R}\\
&=\frac{2I_{in}\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=\frac{V}{Ls}\\
&=\frac{I_{in}R}{RLCs^2+Ls+R}\\
&=\frac{I_{in}\omega_0^{\pht{0}2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
\ea\]
\[\ba
I_C&=VCs\\
&=\frac{I_{in}RLCs^2}{RLCs^2+Ls+R}\\
&=\frac{I_{in}s^2}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
Check consistency:
\bit
\item $\zeta>1$ Overdamped response:
\[\ba
\mathcal{L}\{v\}&=2R\omega_0\zeta\frac{s+\omega_0\zeta-\frac{\zeta}{\sqrt{\zeta^2-1}}\omega_0\sqrt{\zeta^2-1}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}I_{in}\\
&=\frac{2I_{in}R\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\item $\zeta=1$ Critically damped response:
\[\ba
\mathcal{L}\{v\}&=2R\omega_0\qty(\frac{1}{s+\omega_0}-\frac{\omega_0}{s^2+2\omega_0s+\omega_0^{\pht{0}2}})I_{in}\\
&=\frac{2I_{in}R\omega_0s}{s^2+2\omega_0s+\omega_0^{\pht{0}2}}
\ea\]
\item $0<\zeta<1$ Underdamped response:
\[\ba
\mathcal{L}\{v\}&=2R\omega_0\frac{\zeta\qty(s+\omega_0\zeta)-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\omega_0\sqrt{1-\zeta^2}}{s^2+2\omega_0s+\omega_0^{\pht{0}2}})I_{in}\\
&=\frac{2I_{in}R\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\eit
\epr
Total response (time domain):
\bit
\item $\zeta>1$ Overdamped response:
\[v=2R\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}-\qty(v(0^-)\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(v(0^-)\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_R=2\omega_0\zeta\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}-\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_L=\frac{\omega_0}{\sqrt{\zeta^2-1}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))i_{in}(\tau)\dd{\tau}+\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_C=i_{in}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))i_{in}(\tau)\dd{\tau}+\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\item $\zeta=1$ Critically damped response:
\[v=2R\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}+(v(0^-)-(v(0^-)+2i_L(0^-)R)\omega_0t)e^{-\omega_0t}\]
\[i_R=2\omega_0\int_0^t(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}+\qty(\frac{v(0^-)}{R}-\qty(\frac{v(0^-)}{R}+2i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\[i_L=\omega_0^{\pht{0}2}\int_0^t(t-\tau)e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}+\qty(i_L(0^-)+(\frac{1}{2}\frac{v(0^-)}{R}+i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\[i_C=i_{in}-\omega_0\int_0^t\qty(2-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}i_{in}(\tau)\dd{\tau}+\qty(-\frac{v(0^-)}{R}-i_L(0^-)+\qty(\frac{1}{2}\frac{v(0^-)}{R}+i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\item $0<\zeta<1$ Underdamped response:
\[v=2R\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}+e^{-\omega_0\zeta t}\qty(v(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(v(0^-)+2i_L(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_R=2\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}+e^{-\omega_0\zeta t}\qty(\frac{v(0^-)}{R}\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(\frac{v(0^-)}{R}+2i_L(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_L=\frac{\omega_0}{\sqrt{1-\zeta^2}}\int_0^te^{-\omega_0\zeta(t-\tau)}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))i_{in}(\tau)\dd{\tau}+e^{-\omega_0\zeta t}\qty(i_L(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(\frac{1}{2}\frac{v(0^-)}{R\zeta\sqrt{1-\zeta^2}}+i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_C=i_{in}-\omega_0\int_0^te^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))i_{in}(\tau)\dd{\tau}+e^{-\omega_0\zeta t}\qty(\qty(\frac{v(0^-)}{R}+i_L(0^-))\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(\frac{1}{2}\frac{v(0^-)}{R}\frac{1-2\zeta^2}{\zeta\sqrt{1-\zeta^2}}-i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\eit
Total response (Laplace domain):
\[\ba
V&=\frac{I_{in}RLs+v(0^-)RLCs-i_L(0^-)RL}{RLCs^2+Ls+R}\\
&=\frac{2I_{in}R\omega_0\zeta s+v(0^-)s-2i_L(0^-)R\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_R&=\frac{I_{in}Ls+v(0^-)LCs-i_L(0^-)L}{RLCs^2+Ls+R}\\
&=\frac{2I_{in}\omega_0\zeta s+\frac{v(0^-)s}{R}-2i_L(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
I_L&=\frac{I_{in}R+i_L(0^-)RLCs+v(0^-)RC+i_L(0^-)L}{RLCs^2+Ls+R}\\
&=\frac{I_{in}\omega_0^{\pht{0}2}+i_L(0^-)s+\frac{v(0^-)\omega_0}{2R\zeta}+2i_L(0^-)\omega_0\zeta}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
\ea\]
\[\ba
I_C&=\frac{I_{in}RLCs^2-\qty(v(0^-)+i_L(0^-)R)LCs-v(0^-)RC}{RLCs^2+Ls+R}\\
&=\frac{I_{in}s^2-\qty(\frac{v(0^-)}{R}+i_L(0^-))s-\frac{v(0^-)\omega_0}{2R\zeta}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
Steady state (time domain):
\[i_L=i_{in}\]
\[i_R=i_L=0\]
\[v=0\]
Constant source forced response (time domain):
\bit
\item $\zeta>1$ Overdamped response:
\[v=2i_{in}Re^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)\]
\[i_R=2i_{in}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)\]
\[i_L=i_{in}\qty(1-e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)+\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)))\]
\[i_C=i_{in}e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t))\]
\item $\zeta=1$ Critically damped response:
\[v=2i_{in}R\omega_0te^{-\omega_0t}\]
\[i_R=2i_{in}\omega_0te^{-\omega_0t}\]
\[i_L=i_{in}\qty(1-\qty(1+\omega_0t)e^{-\omega_0t})\]
\[i_C=i_{in}\qty(1-\omega_0t)e^{-\omega_0t}\]
\item $0<\zeta<1$ Underdamped response:
\[v=2i_{in}Re^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t)\]
\[i_R=2i_{in}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t)\]
\[i_L=i_{in}\qty(1-e^{-\omega_0\zeta t}\qty(\cos(\omega_0\sqrt{\zeta^2-1}t)+\frac{\zeta}{\sqrt{\zeta^2-1}}\sin(\omega_0\sqrt{\zeta^2-1}t)))\]
\[i_C=i_{in}e^{-\omega_0\zeta t}\qty(\cos(\omega_0\sqrt{\zeta^2-1}t)-\frac{\zeta}{\sqrt{\zeta^2-1}}\sin(\omega_0\sqrt{\zeta^2-1}t))\]
\eit
Constant source total response (time domain):
\bit
\item $\zeta>1$ Overdamped response:
\[v=2i_{in}Re^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)-\qty(v(0^-)\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(v(0^-)\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)R\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_R=2i_{in}e^{-\omega_0\zeta t}\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)-\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}+\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_L=i_{in}\qty(1-e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)+\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t)))+\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\[i_C=i_{in}e^{-\omega_0\zeta t}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}t)-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}t))+\qty(\frac{v(0^-)}{R}\frac{\zeta-\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta-\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta-\sqrt{\zeta^2-1})t}-\qty(\frac{v(0^-)}{R}\frac{\zeta+\sqrt{\zeta^2-1}}{2\sqrt{\zeta^2-1}}+i_L(0^-)\frac{\zeta}{\sqrt{\zeta^2-1}})\frac{\zeta+\sqrt{\zeta^2-1}}{2\zeta}e^{-\omega_0\qty(\zeta+\sqrt{\zeta^2-1})t}\]
\item $\zeta=1$ Critically damped response:
\[v=(v(0^-)+(2i_{in}R-v(0^-)-2i_L(0^-)R)\omega_0t)e^{-\omega_0t}\]
\[i_R=\qty(\frac{v(0^-)}{R}+(2i_{in}-\frac{v(0^-)}{R}-2i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\[i_L=i_{in}-\qty(i_{in}-i_L(0^-)+(i_{in}-\frac{1}{2}\frac{v(0^-)}{R}-i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\[i_C=\qty(i_{in}-\frac{v(0^-)}{R}-i_L(0^-)-\qty(i_{in}-\frac{1}{2}\frac{v(0^-)}{R}-i_L(0^-))\omega_0t)e^{-\omega_0t}\]
\item $0<\zeta<1$ Underdamped response:
\[v=e^{-\omega_0\zeta t}\qty(v(0^-)\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(2i_{in}R-v(0^-)-2i_L(0^-)R)\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_R=e^{-\omega_0\zeta t}\qty(\frac{v(0^-)}{R}\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(i_{in}-\frac{v(0^-)}{R}-2i_L(0^-))\frac{\zeta}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_L=i_{in}-e^{-\omega_0\zeta t}\qty(\qty(i_{in}-i_L(0^-))\cos(\omega_0\sqrt{1-\zeta^2}t)+\qty(i_{in}-\frac{1}{2}\frac{v(0^-)}{R\zeta\sqrt{1-\zeta^2}}-i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\[i_C=e^{-\omega_0\zeta t}\qty(\qty(i_{in}+\frac{v(0^-)}{R}+i_L(0^-))\cos(\omega_0\sqrt{1-\zeta^2}t)-\qty(i_{in}-\frac{v(0^-)}{2R}\frac{1-2\zeta^2}{\zeta\sqrt{1-\zeta^2}}+i_L(0^-)\frac{\zeta}{\sqrt{1-\zeta^2}})\sin(\omega_0\sqrt{1-\zeta^2}t))\]
\eit
Resonance state (time domain): Maximum energy stored $E_m$, total energy lost per period $E_l$, quality factor $Q$.
\[i_{in}=i_m\cos(\omega_0t+\theta)\]
\[v(0^-)=i_mR\]
\[i_L(0^-)=0\]
\[v=i_mR\cos(\omega_0t+\theta)\]
\[i_C=-i_L=-i_mR\omega_0\sin(\omega_0t+\theta)=\frac{i_mR}{L\omega_0}\sin(\omega_0t+\theta)\]
\[E_m=\frac{Ci_m^{\pht{m}2}R^2}{2}\]
\[E_l=\frac{i_m^{\pht{m}2}R\pi}{\omega_0}\]
\[Q=CR\omega_0=R\sqrt{\frac{C}{L}}\]
Resonance state (phasor domain):
\[\mb{I}_{in}=i_me^{j\theta}\]
\[\mb{V}=i_mRe^{j\theta}\]
\[\mb{I}_C=-\mb{I}_L=-ji_mRC\omega_0e^{j\theta}=-\frac{ji_mR}{L\omega_0}e^{j\theta}\]
Impulse response:
\bit
\item $\zeta>1$ Overdamped response:
\[h_v=2R\omega_0\zeta e^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))\]
\[h_{i_R}=2\omega_0\zeta e^{-\omega_0\zeta(t-\tau)}\qty(\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{\zeta}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))\]
\[h_{i_L}=\frac{\omega_0}{\sqrt{\zeta^2-1}}e^{-\omega_0\zeta(t-\tau)}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau))\]
\[h_{i_C}=\delta(t)-\omega_0e^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cosh(\omega_0\sqrt{\zeta^2-1}(t-\tau))-\frac{2\zeta^2-1}{\sqrt{\zeta^2-1}}\sinh(\omega_0\sqrt{\zeta^2-1}(t-\tau)))\]
\item $\zeta=1$ Critically damped response:
\[h_v=2R\omega_0(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}\]
\[h_{i_R}=2\omega_0(1-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}\]
\[h_{i_L}=\omega_0^{\pht{0}2}(t-\tau)e^{-\omega_0(t-\tau)}\]
\[h_{i_C}=\delta(t)-\omega_0\qty(2-\omega_0(t-\tau))e^{-\omega_0(t-\tau)}\]
\item $0<\zeta<1$ Underdamped response:
\[h_v=2R\omega_0e^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))\]
\[h_{i_R}=2\omega_0e^{-\omega_0\zeta(t-\tau)}\qty(\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{\zeta^2}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))\]
\[h_{i_L}=\frac{\omega_0}{\sqrt{1-\zeta^2}}e^{-\omega_0\zeta(t-\tau)}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau))\]
\[h_{i_C}=\delta(t)-\omega_0e^{-\omega_0\zeta(t-\tau)}\qty(2\zeta\cos(\omega_0\sqrt{1-\zeta^2}(t-\tau))-\frac{2\zeta^2-1}{\sqrt{1-\zeta^2}}\sin(\omega_0\sqrt{1-\zeta^2}(t-\tau)))\]
\eit
Transfer function:
\[\ba
H_V&=\frac{RLs}{RLCs^2+Ls+R}\\
&=\frac{2R\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{I_R}&=\frac{Ls}{RLCs^2+Ls+R}\\
&=\frac{2\omega_0\zeta s}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
\[\ba
H_{I_L}&=\frac{R}{RLCs^2+Ls+R}\\
&=\frac{\omega_0^{\pht{0}2}}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}\\
\ea\]
\[\ba
H_{I_C}&=\frac{RLCs^2}{RLCs^2+Ls+R}\\
&=\frac{s^2}{s^2+2\omega_0\zeta s+\omega_0^{\pht{0}2}}
\ea\]
$I_L$ being low-pass filter:
\[\lim_{\omega\to 0}\abs{H_{I_L}(j\omega)}=1\]
\[\lim_{\omega\to\infty}\abs{H_{I_L}(j\omega)}=0\]
$I_C$ being high-pass filter:
\[\lim_{\omega\to 0}\abs{H_{I_C}(j\omega)}=0\]
\[\lim_{\omega\to\infty}\abs{H_{I_C}(j\omega)}=1\]
